<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <!-- examples/PostgresExamples/README.md and examples/SqlServerExamples/README.md list this version. -->
        <PackageVersion Include="Dapper" Version="2.1.89" />
        <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
        <!--
            Its binaries come under the Open Source Maintenance Fee, and its source is MIT.  The owner chose it with
            that known, for tests/SqlSource.Tests alone: nothing that ships may reference it.
        -->
        <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
        <!--
            Central transitive pinning applies this pin to every project, and the Roslyn 5.9.0 that src/SqlSource.Tool
            and the tests reference requires at least this version.
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <!-- examples/SqlServerExamples/README.md lists this version. -->
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <PackageVersion Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
        <!-- examples/SqlServerExamples/README.md lists this version. -->
        <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
        <!-- examples/SqlServerExamples/README.md lists this version. -->
        <PackageVersion Include="NetTopologySuite.IO.SqlServerBytes" Version="2.1.0" />
        <!-- examples/SqlServerExamples/README.md lists this version. -->
        <PackageVersion Include="NodaTime" Version="3.3.7" />
        <!-- examples/PostgresExamples/README.md lists this version. -->
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <!-- examples/PostgresExamples/README.md lists this version. -->
        <PackageVersion Include="Npgsql.NodaTime" Version="10.0.3" />
        <!-- examples/PostgresExamples/README.md lists this version. -->
        <PackageVersion Include="Npgsql.NetTopologySuite" Version="10.0.3" />
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="System.CommandLine" Version="2.0.12" />
        <!--
            Not referenced: central transitive pinning raises the 9.0.18 that Microsoft.Data.SqlClient brings to the
            first build without CVE-2026-70162 and CVE-2026-84008.  Remove it when SqlClient brings that build or later.
        -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
        <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageVersion Include="xunit.analyzers" Version="2.1.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
        <PackageVersion Include="xunit.v3.assert" Version="4.0.1" />
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    </ItemGroup>
</Project>
