<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <PackageVersion Include="Dapper" Version="2.1.89" />
        <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
        <!--
            Central transitive pinning applies this pin to every project, and the Roslyn 5.9.0 that
            tests/SqlSource.Tests references requires at least this version.
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
        <!--
            4.8.0 is the compiler in the .NET 8 SDK and Visual Studio 2022 17.8, the oldest hosts SqlSource supports.
            Raising it drops those hosts: do not raise it without changing the support target in README.md.
            tests/SqlSource.Tests overrides it to run on a current compiler.  tests/SqlSource.Tests.RoslynFloor does
            not, and runs the generator tests on this version.
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="xunit.analyzers" Version="2.1.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>
</Project>
