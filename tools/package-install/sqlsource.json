{
  // tools/check-package-install.sh copies the project to a temporary folder, and "root" ends the chain at the copy,
  // so that no settings file above the copy applies.
  "root": true,
  // The dialect of every query of the project, unless its file names another.
  "dialect": "postgres",
  // Every query of this project is generated as SQL alone, the constants and the token methods.  A query with models
  // would need a sidecar beside its file.
  "output": "Sql",
  // Their members are on the type itself, Queries, which Program.cs reads, in place of its nested class Sql.
  "memberLocation": "class",
  // Token validation is off, so that a query whose markers do not turn it back on does not check its arguments.
  "generatorParameters": ["sort-input", "token-validation=off"],
}
