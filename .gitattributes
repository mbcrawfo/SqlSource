# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF
*.sh text eol=lf

# Files formatted by CSharpier always use LF
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf

# A sidecar is compared byte for byte with what the writer gives, which uses LF
*.sql.json text eol=lf
schemas/*.json text eol=lf

# A describer's fixture is compared byte for byte, and its SQL is in a request that keys a recorded answer
tests/SqlSource.Tool.Tests/Fixtures/Describers/** text eol=lf

# A realistic case's expectation is compared byte for byte, and the `at character` of a refusal counts its query's
# line ends
tests/SqlSource.Tests.Postgres/Realistic/Cases/** text eol=lf
