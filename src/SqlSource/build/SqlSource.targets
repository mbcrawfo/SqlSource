<Project>
    <!--
        NuGet imports this file into each project that references the package, after the project's own content.

        What a build needs of a value or an item that a target can change is done in targets, and not where this file
        is imported: Directory.Build.targets is imported later, and a target can add an item while the build runs.
        The targets of a build hook GenerateMSBuildEditorConfigFileCore, the target of the SDK that writes the file
        the compiler reads its properties from, or run just before CoreCompile from SqlSource.AfterSdk.targets.
        SqlSourceListFiles and SqlSourceWriteManifest hook nothing: a target of a project that adds a .sql file hooks
        SqlSourceListFiles, which runs it before the search for settings files and before the manifest wherever it is
        declared, and the sqlsource tool runs the manifest's target by name.  The targets of the online build, at the
        end of the file, hook nothing either: SqlSourceTrackAdditionalFiles depends on SqlSourceDescribeOnline, which
        runs the rest.
    -->
    <!--
        Gives the generator SqlSourceBuildFolders, the folders the build writes C# files and its outputs into and the
        NuGet package folders, each a full path made against the project's folder with a separator at its end, and
        each after a |: BaseIntermediateOutputPath, IntermediateOutputPath, where the SDK writes its own C# files, such
        as the AssemblyInfo, and the compiler its output, under which it roots the files of every generator,
        BaseOutputPath, OutDir, CompilerGeneratedFilesOutputPath when EmitCompilerGeneratedFiles is true, where the
        compiler roots the generated files instead, NuGetPackageRoot, the global packages folder, and each other folder
        of NuGetPackageFolders, the ;-parted list of it and the fallback folders that a restore writes, split as an
        item without NuGetPackageRoot, which it names too.  A C# file under any of them is the build's or a package's
        and reaches no settings file: with UseArtifactsOutput, or a folder moved out of the project's, the chain of a
        file of the build would climb past the project's root file, and that of a file a package ships as content, as
        Polyfill does, never meets it.  It runs before the file the compiler reads is written, when every property of
        the SDK, of the artifacts layout and of the restore is set, and it sets the property whatever the project
        wrote.  A folder that has no value is left out, since it would be the project's own folder: before a restore,
        neither property of NuGet has one.

        The compiler reads a value up to its first # or ;, and the folders are parted by |, so each folder is written
        with its %, |, # and ; escaped as %25, %7C, %23 and %3B, % first, which the generator decodes in
        Generation/Chains/BuildFolders.cs: the escaping and the decoding change together.  MSBuild reads %XX in a
        project file as the character it stands for, so each escape is written with its % as %25: %2525, %257C, %2523
        and %253B.

        Each folder of NuGetPackageFolders is escaped in its item's metadata, which batches over the items: a property
        batched over them would keep only the last.

        The expressions are long, and a property as written is on one line, so the check of the line length is off.
    -->
    <!-- editorconfig-checker-disable -->
    <Target Name="SqlSourceFindBuildFolders" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
        <ItemGroup>
            <SqlSourcePackageFolder Include="$(NuGetPackageFolders)" Exclude="$(NuGetPackageRoot)" />
            <SqlSourcePackageFolder>
                <SqlSourceFolder>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), %(Identity)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceFolder>
            </SqlSourcePackageFolder>
        </ItemGroup>
        <PropertyGroup>
            <SqlSourceBuildFolders />
            <SqlSourceBuildFolders Condition="'$(BaseIntermediateOutputPath)' != ''"
                >$(SqlSourceBuildFolders)|$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceBuildFolders>
            <SqlSourceBuildFolders Condition="'$(IntermediateOutputPath)' != ''"
                >$(SqlSourceBuildFolders)|$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceBuildFolders>
            <SqlSourceBuildFolders Condition="'$(BaseOutputPath)' != ''"
                >$(SqlSourceBuildFolders)|$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseOutputPath)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceBuildFolders>
            <SqlSourceBuildFolders Condition="'$(OutDir)' != ''"
                >$(SqlSourceBuildFolders)|$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(OutDir)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceBuildFolders>
            <SqlSourceBuildFolders
                Condition="'$(EmitCompilerGeneratedFiles)' == 'true' and '$(CompilerGeneratedFilesOutputPath)' != ''"
                >$(SqlSourceBuildFolders)|$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(CompilerGeneratedFilesOutputPath)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceBuildFolders>
            <SqlSourceBuildFolders Condition="'$(NuGetPackageRoot)' != ''"
                >$(SqlSourceBuildFolders)|$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(NuGetPackageRoot)).Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B'))</SqlSourceBuildFolders>
            <SqlSourceBuildFolders Condition="'@(SqlSourcePackageFolder)' != ''"
                >$(SqlSourceBuildFolders)|@(SqlSourcePackageFolder->'%(SqlSourceFolder)', '|')</SqlSourceBuildFolders>
        </PropertyGroup>
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        Gives the generator SqlSourceTransitivePackageAssemblies, the names of the referenced assemblies that only a
        NuGet package the project does not list itself brings, each once, after a | from the one before: a short type
        name of a .sql file that binds to a type of one of them is warned of, since the package that brings it can
        stop bringing it, or bring another type of that name, when it is updated.  A reference is of a package when
        it has a NuGetPackageId, and is left out when it is the framework's, which has a FrameworkReferenceName, or a
        project's, whose ReferenceSourceTarget is ProjectReference, or when its package is a PackageReference of the
        project, compared ignoring case, as NuGet compares the ids.  The name is the file's, without its extension.

        It has no DependsOnTargets: a build resolves its references, ReferencePath, before the file the compiler
        reads is written, and run by name with nothing resolved, it sets the property empty, so that no name is warned
        of.  The manifest does not depend on it: the tool does not resolve types.

        Each name is escaped as SqlSourceFindBuildFolders escapes a folder, and decoded in
        Generation/Types/MappedTypes/TransitivePackageAssemblies.cs: the escaping and the decoding change together.
        A name's metadata is never the argument of a property function, so the names are joined with a /, which no
        file name holds, the joined list is escaped, and each / is then made a |.  Distinct compares ignoring case.

        The expression is long, and a property as written is on one line, so the check of the line length is off.
    -->
    <!-- editorconfig-checker-disable -->
    <Target Name="SqlSourceFindTransitivePackageAssemblies" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
        <ItemGroup>
            <SqlSourcePackageAssembly
                Include="@(ReferencePath)"
                Condition="'%(ReferencePath.NuGetPackageId)' != '' and '%(ReferencePath.FrameworkReferenceName)' == '' and '%(ReferencePath.ReferenceSourceTarget)' != 'ProjectReference'"
            />
            <SqlSourceListedPackage Include="@(PackageReference)" NuGetPackageId="%(Identity)" />
            <SqlSourcePackageAssembly
                Remove="@(SqlSourceListedPackage)"
                MatchOnMetadata="NuGetPackageId"
                MatchOnMetadataOptions="CaseInsensitive"
            />
            <SqlSourcePackageAssemblyName Include="@(SqlSourcePackageAssembly->'%(Filename)'->Distinct())" />
        </ItemGroup>
        <PropertyGroup>
            <SqlSourcePackageAssemblyNames>@(SqlSourcePackageAssemblyName, '/')</SqlSourcePackageAssemblyNames>
            <SqlSourceTransitivePackageAssemblies>$(SqlSourcePackageAssemblyNames.Replace('%', '%2525').Replace('|', '%257C').Replace('#', '%2523').Replace(';', '%253B').Replace('/', '|'))</SqlSourceTransitivePackageAssemblies>
        </PropertyGroup>
    </Target>
    <!--
        Stops the build on a compiler older than Roslyn 4.14, in which the generator cannot load: the compiler would
        only warn that it cannot, and the project would then fail on the missing members of the generated code.  The
        .NET SDK sets CompilerApiVersion to roslyn<major>.<minor>, as roslyn4.14 in the SDK 9.0.300 and later and in
        Visual Studio 2022 17.14 and later; a value of any other form is not a version this target knows, and passes.
        The text is that of SqlDiagnostics.CompilerTooOld, with {0} where it writes the version: they change together.
    -->
    <Target Name="SqlSourceCheckCompilerVersion" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
        <PropertyGroup>
            <SqlSourceCompilerApiVersion
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(CompilerApiVersion)', '^roslyn\d{1,4}\.\d{1,4}$'))"
                >$(CompilerApiVersion.Substring(6))</SqlSourceCompilerApiVersion>
        </PropertyGroup>
        <Error
            Code="SQLSRC021"
            Text="SqlSource needs the C# compiler of the .NET SDK 9.0.300 or later, or of Visual Studio 2022 17.14 or later, and this build's compiler is Roslyn $(SqlSourceCompilerApiVersion).  Update the .NET SDK or Visual Studio; a project can still target .NET 8."
            Condition="'$(SqlSourceCompilerApiVersion)' != '' and $([MSBuild]::VersionLessThan('$(SqlSourceCompilerApiVersion)', '4.14'))"
        />
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        The hook for a target of a project that adds a .sql file while the build runs, as one that writes its .sql
        files does: such a target says BeforeTargets="SqlSourceListFiles", wherever it is declared, so that its files
        are searched above and are in the manifest.  The search for settings files and the manifest's target depend on
        it, and it does nothing itself and hooks nothing, so it runs only as what they depend on.
    -->
    <Target Name="SqlSourceListFiles" />
    <!--
        Finds the settings files: every sqlsource.json in the folder of a .sql file or of a Compile item, or in a folder
        above it, to the top of the drive, as the SDK finds .editorconfig files.  A generator cannot read the disk, so
        each is given to the compiler as an AdditionalFiles item.  The SDK's step through FullPath and Distinct is
        here for the same reason as there: GetPathsOfAllDirectoriesAbove can give one folder twice for a file linked
        with a relative path (msbuild issue 4392).  A file that the project lists itself is not added again, so that
        the compiler is given none twice; the comparison is of full paths, since the project may list it by another.

        Each file is given by its path relative to the project's folder, as the project's own .sql and C# files are.
        The compiler makes such a path full against its working folder, where a symbolic link on the way is resolved,
        while MSBuild keeps the link in a full path, and the generator compares the paths as text: a file given by its
        full path through a link would reach none of the project's files.  A file outside the deepest link among the
        project's folder and the folders above it is given by its full path instead, since its relative path would
        climb out of the folder the link leads to and name another file, which the compiler fails the build on.  A
        link is a folder whose attributes hold ReparsePoint, and the deepest is the one link above no other.

        The search is three targets.  SqlSourceListSettingsFiles lists the files and the project's folders,
        SqlSourceFindProjectLinks finds the links among the folders, once for each, and SqlSourceFindSettingsFiles,
        which a build hooks and the others depend on, adds the files, once for each.  A path goes through a property
        on its way into a property function, since metadata would be text inside it, cut short by a quote.

        It runs in a target, and not where this file is imported, so that a .sql file that a target adds is searched
        above too.  In a build it runs just before CoreCompile, from SqlSource.AfterSdk.targets, after every target of
        the project that hooks CoreCompile; where that file is not imported, SqlSourceSettingsSearchHook hooks it to
        GenerateMSBuildEditorConfigFileCore instead, and a .sql file that a later target adds, one that hooks that
        target or CoreCompile, is not searched above: TD-0016.  It depends on SqlSourceListFiles, so that a target
        that hooks it to add a .sql file runs first.  An IDE lists the items of a project as evaluated, never one
        that a target adds, so Visible="false" is only for one that might; a settings file in the project's folder is
        listed anyway, as None or Content.

        The chains of item functions and the conditions are one attribute each, and cannot be wrapped, so the check of
        the line length is off for the targets.
    -->
    <!-- editorconfig-checker-disable -->
    <Target Name="SqlSourceListSettingsFiles" DependsOnTargets="SqlSourceListFiles">
        <ItemGroup>
            <SqlSourceSettingsSearchStart Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.sql'" />
            <SqlSourceSettingsSearchStart Include="@(Compile)" />
            <SqlSourceSettingsSearchFolder Include="@(SqlSourceSettingsSearchStart->GetPathsOfAllDirectoriesAbove())" />
            <SqlSourceSettingsFileFound Include="@(SqlSourceSettingsSearchFolder->'%(FullPath)'->Distinct()->Combine('sqlsource.json')->Exists())" />
            <SqlSourceSettingsFileNew
                Include="@(SqlSourceSettingsFileFound)"
                Exclude="@(AdditionalFiles->'%(FullPath)')"
            />
            <SqlSourceSettingsSearchProject Include="$(MSBuildProjectFullPath)" />
            <SqlSourceSettingsSearchProjectFolder Include="@(SqlSourceSettingsSearchProject->GetPathsOfAllDirectoriesAbove())" />
        </ItemGroup>
    </Target>
    <Target
        Name="SqlSourceFindProjectLinks"
        DependsOnTargets="SqlSourceListSettingsFiles"
        Outputs="%(SqlSourceSettingsSearchProjectFolder.Identity)"
    >
        <PropertyGroup>
            <SqlSourceSettingsSearchPath>%(SqlSourceSettingsSearchProjectFolder.FullPath)</SqlSourceSettingsSearchPath>
        </PropertyGroup>
        <ItemGroup>
            <SqlSourceSettingsSearchLink
                Include="@(SqlSourceSettingsSearchProjectFolder)"
                Condition="$([System.IO.File]::GetAttributes($(SqlSourceSettingsSearchPath)).ToString().Contains('ReparsePoint'))"
            />
        </ItemGroup>
    </Target>
    <Target
        Name="SqlSourceFindSettingsFiles"
        BeforeTargets="$(SqlSourceSettingsSearchHook)"
        DependsOnTargets="SqlSourceListFiles;SqlSourceListSettingsFiles;SqlSourceFindProjectLinks"
        Outputs="%(SqlSourceSettingsFileNew.Identity)"
    >
        <ItemGroup>
            <SqlSourceSettingsSearchDeepestLink Remove="@(SqlSourceSettingsSearchDeepestLink)" />
            <SqlSourceSettingsSearchDeepestLink
                Include="@(SqlSourceSettingsSearchLink)"
                Exclude="@(SqlSourceSettingsSearchLink->GetPathsOfAllDirectoriesAbove())"
            />
        </ItemGroup>
        <PropertyGroup>
            <SqlSourceSettingsSearchPath>%(SqlSourceSettingsFileNew.FullPath)</SqlSourceSettingsSearchPath>
            <SqlSourceSettingsSearchUnder>@(SqlSourceSettingsSearchDeepestLink)</SqlSourceSettingsSearchUnder>
            <SqlSourceSettingsSearchUnder Condition="'$(SqlSourceSettingsSearchUnder)' != ''"
                >$([MSBuild]::EnsureTrailingSlash($(SqlSourceSettingsSearchUnder)))</SqlSourceSettingsSearchUnder>
            <SqlSourceSettingsSearchInside>$(SqlSourceSettingsSearchPath.StartsWith($(SqlSourceSettingsSearchUnder)))</SqlSourceSettingsSearchInside>
        </PropertyGroup>
        <ItemGroup Condition="'$(SqlSourceSettingsSearchPath)' != ''">
            <AdditionalFiles
                Include="$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), $(SqlSourceSettingsSearchPath)))"
                Condition="$(SqlSourceSettingsSearchInside)"
                Visible="false"
            />
            <AdditionalFiles
                Include="@(SqlSourceSettingsFileNew)"
                Condition="!$(SqlSourceSettingsSearchInside)"
                Visible="false"
            />
        </ItemGroup>
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        Makes the build after a .sql file is deleted, renamed or moved compile again.  A file that is gone has no
        timestamp to compare, and the SDK's own record of what the compiler was given does not hold AdditionalFiles.
        CustomAdditionalCompileInputs is the item the SDK reads for more inputs of the compiler.  The file holds a hash
        of the list and is written only when the hash changes, so a build with the same files does not compile for it.
        It depends on the search, so that a settings file that is added, deleted or moved changes the hash too, and
        runs where the search runs, through SqlSourceSettingsSearchHook, so that a .sql file a late target adds is
        hashed as well.  It depends on SqlSourceDescribeOnline after the search, so that the online build runs the
        sqlsource tool in both places the search runs, and the hash holds a sidecar the run created.
    -->
    <Target
        Name="SqlSourceTrackAdditionalFiles"
        BeforeTargets="$(SqlSourceSettingsSearchHook)"
        DependsOnTargets="SqlSourceFindSettingsFiles;SqlSourceDescribeOnline"
    >
        <PropertyGroup>
            <SqlSourceFilesCache>$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.cache</SqlSourceFilesCache>
        </PropertyGroup>
        <Hash ItemsToHash="@(AdditionalFiles)">
            <Output TaskParameter="HashResult" PropertyName="SqlSourceFilesHash" />
        </Hash>
        <WriteLinesToFile
            File="$(SqlSourceFilesCache)"
            Lines="$(SqlSourceFilesHash)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
        <ItemGroup>
            <CustomAdditionalCompileInputs Include="$(SqlSourceFilesCache)" />
            <FileWrites Include="$(SqlSourceFilesCache)" />
        </ItemGroup>
    </Target>
    <!--
        What SqlSourceWriteManifest depends on.  A target's DependsOnTargets is read before the target runs, so the
        list is a property and is set here, where the file is imported: this, the nesting below, the group of the
        settings files and the online build's group are the elements of the file that are not a target.
        SqlSourceListFiles is first, so that a target of a project that hooks it to add a .sql file runs before the
        rest.  The search gives the manifest the settings files that it adds to what the compiler is given.
        SqlSourceSettingsSearchHook is what the search and the hash hook in a build, and SqlSource.AfterSdk.targets
        empties it when it runs them itself.  The property of the build's folders is set by a target,
        SqlSourceFindBuildFolders, so the manifest's target runs it, or the manifest would hold the property empty.

        AddImplicitDefineConstants is a target of the SDK and not a contract: TD-0027.  It adds the constants of the
        framework, NET10_0 and NET8_0_OR_GREATER among them, which the SDK otherwise adds only on the way to a
        compile.  A project that is not of the SDK has no TargetFramework and no such target.

        The list is long, and a property as written is on one line: white space around the value would be part of it.
        So the check of the line length is off for the group.
    -->
    <!-- editorconfig-checker-disable -->
    <PropertyGroup>
        <SqlSourceSettingsSearchHook>GenerateMSBuildEditorConfigFileCore</SqlSourceSettingsSearchHook>
        <SqlSourceManifestDependsOn>SqlSourceListFiles;SqlSourceFindSettingsFiles;SqlSourceFindBuildFolders</SqlSourceManifestDependsOn>
        <SqlSourceManifestDependsOn Condition="'$(TargetFramework)' != ''"
            >$(SqlSourceManifestDependsOn);AddImplicitDefineConstants</SqlSourceManifestDependsOn>
    </PropertyGroup>
    <!-- editorconfig-checker-enable -->
    <!--
        Nests a sidecar under its .sql file in the solution explorer of an IDE, Users.sql.json under Users.sql, and
        keeps it out of the output and publish folders.  The IDEs nest from the evaluated items, so this is outside
        every target.  It is in this file, and not in the props, so that it reaches a sidecar that a project lists
        itself when SqlSourceIncludeFiles is off.  It is on None and Content too, since an IDE may nest on any of
        them: the SDK lists every file of the project under None, and the Web SDK lists a .json file under Content
        instead.  Update changes the items that are already listed and adds none.

        A sidecar is an input of the generator alone, so neither the build nor a publish copies it.  The Web SDK has
        its Content copied to the output and publish folders, a .json file among it, and Never overrides that: the
        targets are imported after the project's content.  None is copied only when a project asks, and is left as
        the project has it.
    -->
    <ItemGroup>
        <AdditionalFiles Update="**/*.sql.json" DependentUpon="%(Filename)" />
        <None Update="**/*.sql.json" DependentUpon="%(Filename)" />
        <Content
            Update="**/*.sql.json"
            DependentUpon="%(Filename)"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="Never"
        />
    </ItemGroup>
    <!--
        Keeps a settings file out of the output and publish folders, as the nesting above keeps a sidecar: it is an
        input of the generator alone, and the Web SDK lists a .json file under Content, which it copies.  It is here
        and not in the props because NuGet imports the props before the Web SDK adds its Content, and an Update
        changes only the items that are already listed.
    -->
    <ItemGroup>
        <Content Update="**/sqlsource.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>
    <!--
        Writes the project manifest: what the compiler is given, for the sqlsource tool, which runs this target by
        name, and for the online build, which runs it through the dependencies of SqlSourceRunOnline.  It hooks nothing
        on purpose, since a hook would make every build write the manifest.  When the tool runs it by name, nothing of a
        build runs before it but what it depends on: SqlSourceListFiles, the searches for settings files and for the
        build's folders and, for a project of the SDK, AddImplicitDefineConstants.  A .sql file that a target adds is in
        the manifest only when that target hooks SqlSourceListFiles.  TD-0025.

        The file is lines of key=value, and its format is a contract with the tool: the rules are in
        src/SqlSource/build/AGENTS.md, and the reasons in docs/architecture/msbuild-and-manifest.md.  The tool names the
        file with SqlSourceManifestFile; without it the file is under obj, and is added to FileWrites.  That reaches
        "dotnet clean" only from inside a build, so it has an effect only in an online build.

        It holds no setting: the tool reads the settings from the files of the Settings lines, as the generator
        does.  A property goes through Escape, or MSBuild would make an item of each part of a value that holds a
        semicolon, as DefineConstants does.  A property of the SDK is put on one line first: a project may write its
        constants one on each line, and a line break inside a value would end its line of the file.
        SqlSourceBuildFolders holds the folders escaped as the compiler is given them, and the tool decodes them as the
        generator does.  A path comes from an item and is not split.

        A Settings line is written for every AdditionalFiles item named sqlsource.json, the ones the search added and
        any the project lists itself, so that the tool reads exactly the settings files the compiler is given.  Each
        is written once, by its full path, since the project may list a file by a relative path too.
    -->
    <!-- editorconfig-checker-disable -->
    <Target Name="SqlSourceWriteManifest" DependsOnTargets="$(SqlSourceManifestDependsOn)">
        <PropertyGroup>
            <SqlSourceManifestIsDefault Condition="'$(SqlSourceManifestFile)' == ''">true</SqlSourceManifestIsDefault>
            <SqlSourceManifestFile Condition="'$(SqlSourceManifestFile)' == ''"
                >$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.manifest</SqlSourceManifestFile>
        </PropertyGroup>
        <ItemGroup>
            <SqlSourceManifestLine Include="SqlSourceManifest=2" />
            <SqlSourceManifestLine Include="Project=$([MSBuild]::Escape($(MSBuildProjectFullPath)))" />
            <SqlSourceManifestLine Include="TargetFramework=$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($(TargetFramework), '\s+', ' ').Trim())))" />
            <SqlSourceManifestLine Include="LangVersion=$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($(LangVersion), '\s+', ' ').Trim())))" />
            <SqlSourceManifestLine Include="DefineConstants=$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($(DefineConstants), '\s+', ' ').Trim())))" />
            <SqlSourceManifestLine Include="SqlSourceBuildFolders=$([MSBuild]::Escape($(SqlSourceBuildFolders)))" />
            <SqlSourceManifestSqlFile Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.sql'" />
            <SqlSourceManifestLine Include="@(SqlSourceManifestSqlFile->'File=%(FullPath)')" />
            <SqlSourceManifestSettingsFile
                Include="@(AdditionalFiles)"
                Condition="'%(Filename)%(Extension)' == 'sqlsource.json'"
            />
            <SqlSourceManifestLine Include="@(SqlSourceManifestSettingsFile->'%(FullPath)'->Distinct()->'Settings=%(Identity)')" />
            <SqlSourceManifestLine Include="@(Compile->'Compile=%(FullPath)')" />
        </ItemGroup>
        <WriteLinesToFile
            File="$(SqlSourceManifestFile)"
            Lines="@(SqlSourceManifestLine)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
        <ItemGroup Condition="'$(SqlSourceManifestIsDefault)' == 'true'">
            <FileWrites Include="$(SqlSourceManifestFile)" />
        </ItemGroup>
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        The online build: a build runs the sqlsource tool on its project before the compiler reads its inputs, when a
        connection is configured, so that the compiler is given sidecars of the schema as it is now.  SqlSourceOnline
        is the project's: auto, or empty, runs the tool when the build finds a connection source and is not in CI,
        true runs it whenever the build is not in CI, and false never runs it, each matched ignoring case and the
        white space around it.  SqlSourceOnlineValue is auto, true or false, or the value as written when it is none
        of them, which SqlSourceDescribeOnline reports as SQLSRC024.  A comparison of a condition reads yes, on and no
        as booleans, so that 'yes' == 'true' holds, and the value is compared by Equals instead, after
        ToLowerInvariant until it is one of the three.  No build in CI runs the tool, so that the job
        that checks the sidecars never rewrites them: CI is recognised by the variables the services set.

        A connection source is the variable SQLSOURCE_CONNECTION set and not blank, or the .env file: the file
        SqlSourceEnvFile names, trimmed, from the project's folder when its path is relative, else the project folder's
        .env, never one in a folder above, and none when SqlSourceEnvFile is none, which a condition matches ignoring
        case.  The build tests only that a file, not a folder, is at the path, as the tool passes over a folder, and
        never reads it.  When SqlSourceEnvFile is set, the build gives the tool the full path, or none, as the value of
        its env-file option, so that both look at the one file, and a default build's command is unchanged.  A symbolic
        link to a file that is not there is a file to File.Exists and none to the tool, so under auto it starts a tool
        that goes on offline, at every build: the manual says so.  MSBuild logs a variable that a file reads as a
        property with its value, at the detailed verbosity and in a binary log, so the variable is read by a property
        function whose answer alone is the property: no file of the package names it as a property, and BuildFileTests
        holds that.  A project whose connections are only in named variables, which a condition cannot list, sets true.

        SqlSourceToolCommand is how the build starts the tool, a local tool of the repository by default; the tests
        set it to a stand-in of the tool.  SqlSourceFirstFramework is the framework of TargetFrameworks that the tool
        describes, as a run by hand does.  SqlSourceDescribeOnline runs the tool itself only in a project with no
        TargetFrameworks; a multi-targeted project runs it in a configuration of its own.

        buildMultiTargeting/SqlSource.targets, which NuGet imports into the outer build of a multi-targeted project,
        where this file is not imported, defines the properties its condition reads with the same text, which
        BuildFileTests holds equal.  Both add SQLSRC026, the warning of a tool that cannot start under auto, to
        MSBuildWarningsNotAsErrors, so that -warnaserror leaves it a warning: MSBuild reads that property from the
        project as evaluated, so it is set here, after the project's content.

        The values and conditions are long, and a property as written is on one line, so the check of the line length
        is off for the group and the targets after it.
    -->
    <!-- editorconfig-checker-disable -->
    <PropertyGroup>
        <SqlSourceToolCommand Condition="'$(SqlSourceToolCommand)' == ''">dotnet sqlsource</SqlSourceToolCommand>
        <SqlSourceOnlineValue>$(SqlSourceOnline.Trim())</SqlSourceOnlineValue>
        <SqlSourceOnlineValue
            Condition="'$(SqlSourceOnlineValue)' == '' or $(SqlSourceOnlineValue.ToLowerInvariant().Equals('auto'))"
            >auto</SqlSourceOnlineValue>
        <SqlSourceOnlineValue Condition="$(SqlSourceOnlineValue.ToLowerInvariant().Equals('true'))"
            >true</SqlSourceOnlineValue>
        <SqlSourceOnlineValue Condition="$(SqlSourceOnlineValue.ToLowerInvariant().Equals('false'))"
            >false</SqlSourceOnlineValue>
        <SqlSourceInCI>false</SqlSourceInCI>
        <SqlSourceInCI
            Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'True' or '$(TEAMCITY_VERSION)' != '' or '$(JENKINS_URL)' != ''"
            >true</SqlSourceInCI>
        <SqlSourceHasConnectionVariable>true</SqlSourceHasConnectionVariable>
        <SqlSourceHasConnectionVariable
            Condition="$([System.String]::IsNullOrWhiteSpace($([System.Environment]::GetEnvironmentVariable('SQLSOURCE_CONNECTION'))))"
            >false</SqlSourceHasConnectionVariable>
        <SqlSourceEnvFileValue>$(SqlSourceEnvFile.Trim())</SqlSourceEnvFileValue>
        <SqlSourceEnvFilePath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '.env'))</SqlSourceEnvFilePath>
        <SqlSourceEnvFilePath Condition="'$(SqlSourceEnvFileValue)' != ''"
            >$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(SqlSourceEnvFileValue)))</SqlSourceEnvFilePath>
        <SqlSourceEnvFilePath Condition="'$(SqlSourceEnvFileValue)' == 'none'" />
        <SqlSourceHasEnvFile>false</SqlSourceHasEnvFile>
        <SqlSourceHasEnvFile
            Condition="'$(SqlSourceEnvFilePath)' != '' and $([System.IO.File]::Exists($(SqlSourceEnvFilePath)))"
            >true</SqlSourceHasEnvFile>
        <SqlSourceFirstFramework>$([System.Text.RegularExpressions.Regex]::Match($(TargetFrameworks), '[^;\s]+'))</SqlSourceFirstFramework>
        <SqlSourceGoesOnline>false</SqlSourceGoesOnline>
        <SqlSourceGoesOnline
            Condition="'$(SqlSourceInCI)' != 'true' and ($(SqlSourceOnlineValue.Equals('true')) or ($(SqlSourceOnlineValue.Equals('auto')) and ('$(SqlSourceHasConnectionVariable)' == 'true' or '$(SqlSourceHasEnvFile)' == 'true')))"
            >true</SqlSourceGoesOnline>
        <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);SQLSRC026</MSBuildWarningsNotAsErrors>
        <SqlSourceDescribeOnlineDependsOn />
        <SqlSourceDescribeOnlineDependsOn Condition="'$(TargetFrameworks)' == ''"
            >SqlSourceRunOnline</SqlSourceDescribeOnlineDependsOn>
    </PropertyGroup>
    <!--
        Describes the project's queries before the compiler reads its inputs, when the build goes online, and gives the
        compiler the sidecars the run created.  SqlSourceTrackAdditionalFiles depends on it after the search for
        settings files, so it runs wherever the search runs, just before CoreCompile or before
        GenerateMSBuildEditorConfigFileCore, and it hooks nothing of its own.  It is no part of a design-time build,
        which an IDE runs on every edit, nor of a compile by -t:Compile, which leaves BuildingProject false.

        The tool runs once, for the first framework, in SqlSourceRunOnline: two frameworks can claim different files,
        and a run for each would undo what the other wrote.  In a project with no TargetFrameworks this target depends
        on it, through SqlSourceDescribeOnlineDependsOn, since a target's dependencies are read before it runs: the run
        is then part of the build, after the build's own hooks of CoreCompile, and needs no configuration of its own,
        which would cost the build an evaluation of the project.

        Every framework of a multi-targeted project, the first among them, calls it instead in a configuration of its
        own, the first framework's with SqlSourceOnlineRun=true, which MSBuild runs once, a second caller waiting for
        it.  Run in a framework's own configuration, it would run the search for settings files and the manifest's other
        dependencies there before that build's hooks of CoreCompile, and that build would not run them again, so that a
        settings file reached only by a .sql file that such a hook adds would never reach its compiler.  In the
        configuration of its own, SqlSourceRunOnline and its dependencies are all that runs, none of them calls back
        into a build, and nothing reads SqlSourceOnlineRun, so the run's condition, the CI rule and the test of a
        design-time build among it, reads there as in the framework's own build.  In a build of every framework the outer
        build has called it before it dispatched the inner builds, from buildMultiTargeting/SqlSource.targets, so the
        call is answered at once; a build of one framework, by -f or through a ProjectReference, has no outer build and
        runs it from here.  The run returns the files it wrote under obj, the first framework's, and they are added to
        FileWrites, so that IncrementalClean keeps them and a clean deletes them: a configuration that is called by name
        runs no IncrementalClean of its own.  Another framework's build adds them too, and its IncrementalClean passes
        over a file outside its own obj folder.  A second call, to SqlSourceCreatedSidecars in the same configuration,
        gives the sidecars the run created, which go to the compiler and not to FileWrites.

        A sidecar the tool deleted is taken out of the items, or the compiler would fail on a file that is not there:
        a .sql.json item is one whose name, less its .json, ends in .sql.  A sidecar the run created is no item when
        the project was evaluated before the run, so it is added unless an item names it: its .sql file was described
        in this build, and the compiler of the same build is given what it wrote.  That holds whatever
        SqlSourceIncludeFiles is and wherever the .sql file is.  A sidecar that existed before the run, which the
        project does not list, stays out, as in an offline build or CI, so that a project that forgets to list its
        sidecars fails the same way in all three.  A run skipped as up to date created nothing: what an earlier run
        created, the project's patterns list at the next evaluation.  The items are compared by their full paths,
        since an Exclude in a target compares the paths as written, and an item the project lists by a relative path
        would otherwise be added again.
    -->
    <Target
        Name="SqlSourceDescribeOnline"
        Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'"
        DependsOnTargets="$(SqlSourceDescribeOnlineDependsOn)"
    >
        <Error
            Code="SQLSRC024"
            File="$(MSBuildProjectFullPath)"
            Text="SqlSourceOnline is '$(SqlSourceOnlineValue)', which is not auto, true or false.  Set it to one of the three, or leave it empty for auto."
            HelpLink="https://github.com/mbcrawfo/SqlSource/blob/main/docs/manual/diagnostics.md#sqlsrc024"
            Condition="!$(SqlSourceOnlineValue.Equals('auto')) and !$(SqlSourceOnlineValue.Equals('true')) and !$(SqlSourceOnlineValue.Equals('false'))"
        />
        <MSBuild
            Projects="$(MSBuildProjectFullPath)"
            Targets="SqlSourceRunOnline"
            Properties="TargetFramework=$(SqlSourceFirstFramework);SqlSourceOnlineRun=true"
            Condition="'$(SqlSourceGoesOnline)' == 'true' and '$(TargetFrameworks)' != ''"
        >
            <Output TaskParameter="TargetOutputs" ItemName="SqlSourceOnlineFile" />
        </MSBuild>
        <MSBuild
            Projects="$(MSBuildProjectFullPath)"
            Targets="SqlSourceCreatedSidecars"
            Properties="TargetFramework=$(SqlSourceFirstFramework);SqlSourceOnlineRun=true"
            Condition="'$(SqlSourceGoesOnline)' == 'true' and '$(TargetFrameworks)' != ''"
        >
            <Output TaskParameter="TargetOutputs" ItemName="SqlSourceSidecarCreated" />
        </MSBuild>
        <ItemGroup>
            <FileWrites Include="@(SqlSourceOnlineFile)" />
        </ItemGroup>
        <ItemGroup Condition="'$(SqlSourceGoesOnline)' == 'true'">
            <SqlSourceJsonFileGone
                Include="@(AdditionalFiles)"
                Condition="'%(Extension)' == '.json' and !Exists('%(FullPath)')"
            />
            <SqlSourceJsonFileGoneStem
                Include="@(SqlSourceJsonFileGone->'%(RootDir)%(Directory)%(Filename)')"
                SqlSourceItem="%(Identity)"
            />
            <SqlSourceSidecarGone
                Include="@(SqlSourceJsonFileGoneStem->'%(SqlSourceItem)')"
                Condition="'%(Extension)' == '.sql'"
            />
            <AdditionalFiles Remove="@(SqlSourceSidecarGone)" />
        </ItemGroup>
        <ItemGroup Condition="'$(SqlSourceGoesOnline)' == 'true'">
            <SqlSourceListedFile Include="@(AdditionalFiles->'%(FullPath)')" />
            <SqlSourceSidecarNotListed Include="@(SqlSourceSidecarCreated)" Exclude="@(SqlSourceListedFile)" />
            <AdditionalFiles Include="@(SqlSourceSidecarNotListed)" />
        </ItemGroup>
    </Target>
    <!--
        Prepares the run of the tool, as what SqlSourceRunOnline depends on after the manifest, so that every file
        the run compares is written in the configuration that runs the tool, before its check of what is up to date,
        wherever it is called from.  It writes two files under obj, each only when its text changes: the list of the
        sidecars of the .sql files that exist, so that a deleted sidecar runs the tool again, and the value of
        SqlSourceOnline with the folder of this file, whose path in NuGet's cache names the package's version, and the
        path of the .env file, which no line gives under none, so that a change of any of them does.  NuGet keeps a
        package's files at the time they were packed, and the file SqlSourceEnvFile comes to name can be older than the
        stamp, so the files themselves would not.  WriteLinesToFile writes an empty file for an empty list.

        It gathers the run's inputs too: the manifest; the .sql files and the settings files among the AdditionalFiles
        items; the sidecars of the .sql files, so that one a checkout replaced is described again; the two files above;
        the .env file, when a file is at its path; and the tool manifests above the project, which dotnet tool update
        rewrites.  GetPathOfFileAbove takes no folder in the name, so the tool manifest under .config is found
        by its folder.  Each found path comes from a property function, which gives it unescaped, so it is escaped
        before it is an item.
    -->
    <Target Name="SqlSourceListSidecars">
        <PropertyGroup>
            <SqlSourceSidecarList>$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.sidecars</SqlSourceSidecarList>
            <SqlSourceOnlineValueFile>$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.online</SqlSourceOnlineValueFile>
            <SqlSourceOnlineStamp>$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.stamp</SqlSourceOnlineStamp>
            <SqlSourceToolManifestFolder>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.config/dotnet-tools.json'))</SqlSourceToolManifestFolder>
            <SqlSourceRootToolManifestFolder>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'dotnet-tools.json'))</SqlSourceRootToolManifestFolder>
        </PropertyGroup>
        <ItemGroup>
            <SqlSourceSidecarOfSqlFile
                Include="@(AdditionalFiles->'%(FullPath).json')"
                Condition="'%(Extension)' == '.sql'"
            />
            <SqlSourceSidecarListed Include="@(SqlSourceSidecarOfSqlFile->Exists())" />
            <SqlSourceOnlineValueLine Include="$(SqlSourceOnlineValue)" />
            <SqlSourceOnlineValueLine Include="$(MSBuildThisFileDirectory)" />
            <SqlSourceOnlineValueLine Include="$([MSBuild]::Escape($(SqlSourceEnvFilePath)))" />
        </ItemGroup>
        <WriteLinesToFile
            File="$(SqlSourceSidecarList)"
            Lines="@(SqlSourceSidecarListed)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
        <WriteLinesToFile
            File="$(SqlSourceOnlineValueFile)"
            Lines="@(SqlSourceOnlineValueLine)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
        <ItemGroup>
            <FileWrites Include="$(SqlSourceSidecarList)" />
            <FileWrites Include="$(SqlSourceOnlineValueFile)" />
            <SqlSourceOnlineInput Include="$(SqlSourceManifestFile)" />
            <SqlSourceOnlineInput
                Include="@(AdditionalFiles)"
                Condition="'%(Extension)' == '.sql' or '%(Filename)%(Extension)' == 'sqlsource.json'"
            />
            <SqlSourceOnlineInput Include="@(SqlSourceSidecarListed)" />
            <SqlSourceOnlineInput Include="$(SqlSourceSidecarList)" />
            <SqlSourceOnlineInput Include="$(SqlSourceOnlineValueFile)" />
            <SqlSourceOnlineInput
                Include="$([MSBuild]::Escape($(SqlSourceEnvFilePath)))"
                Condition="'$(SqlSourceHasEnvFile)' == 'true'"
            />
            <SqlSourceOnlineInput
                Include="$([MSBuild]::Escape($([MSBuild]::NormalizePath($(SqlSourceToolManifestFolder), '.config', 'dotnet-tools.json'))))"
                Condition="'$(SqlSourceToolManifestFolder)' != ''"
            />
            <SqlSourceOnlineInput
                Include="$([MSBuild]::Escape($([MSBuild]::NormalizePath($(SqlSourceRootToolManifestFolder), 'dotnet-tools.json'))))"
                Condition="'$(SqlSourceRootToolManifestFolder)' != ''"
            />
        </ItemGroup>
    </Target>
    <!--
        Runs the sqlsource tool on the manifest of this build, unless every input is older than the stamp.  Its
        condition is the run's alone, and leaves BuildingProject out: a configuration that another build calls by
        name starts with BuildingProject false.  It depends on the manifest and on SqlSourceListSidecars, so that the
        files it compares are written first wherever it is called from: from SqlSourceDescribeOnline, from a
        framework's build, or from the outer build.  It returns the files it writes under obj, the manifest only when it
        is the build's own, for the build that called it to add to FileWrites.

        Exec reads the tool's errors as a compiler's, which under online the tool writes on one line each.  It ignores
        the exit code, since it would otherwise add an error of its own to the tool's, and it keeps every line, of both
        streams, for this target to read.  The summary and the offline line are messages of low importance: the build
        says what failed, and -v:d shows the rest.  Under SQLSOURCE_LOG the tool writes its log to a file of this
        project and framework, since projects built at once would otherwise open one file.  Exec runs the command in the
        system's shell, /bin/sh or cmd, which reads some characters even within quotes, and a project's name, its obj
        folder or the .env file's path can hold them, so each path is escaped for that shell first.  For /bin/sh each
        $, `, " and \ is put in single quotes between the double ones, and not after a \: MSBuild on Unix turns each \
        of a value that names a file that exists into a /.  For cmd each % is doubled, and no path there holds a ".  On
        Windows the tool reads its arguments by the C runtime's rules, where a \ before a " escapes it, so the
        backslashes that end the .env file's path, which SqlSourceEnvFile can give as a folder, are doubled before its
        closing quote; the manifest's and the log's paths end in their file's name.

        When dotnet cannot start the tool, it prints its own words, which are localised, and its exit code is no guide,
        so a run that printed no line of the tool's own is a tool that did not start: a line starting sqlsource:, which
        each line of its summary does under online, or an error of the tool.  Under true that fails the build,
        SQLSRC025; under auto the build goes on with the committed sidecars, SQLSRC026, a warning.  Exec would read a
        line of the summary without that prefix as an error or a warning of the build when the database is named error
        or warning.  A tool that started, exited other than 0 and reported no error of its own fails the build with
        SQLSRC027, which names the exit code and its first line, and when that line is the tool's own and is neither the
        offline line, the online line nor a line of the summary, as a usage error from a tool older than the package is,
        says to update the tool.  Their texts, and that of SQLSRC024 in SqlSourceDescribeOnline, are the messages of
        SqlDiagnostics.OnlineToolCannotRun, OnlineToolCannotRunOffline, OnlineToolFailedSilently and OnlineValueInvalid,
        with {0}, {1} and {2} where the targets write a property: they change together.  The lines are joined with line
        breaks, since a line can hold any character but one, and a property function never takes an item's metadata,
        which MSBuild puts in as text.

        The list of sidecars is written again after the run, from the files on the disk, or a sidecar the run created or
        deleted would change it and run the tool once more at the next build.  The sidecars on the list after the run
        and not before it are the ones the run created, for SqlSourceDescribeOnline to give the compiler; a run skipped
        as up to date leaves the two lists equal, since MSBuild still runs a skipped target's groups.  The stamp is
        touched only after a run that started, exited with 0 and did not print the offline line, so that a failed or
        offline run is tried again by the next build.  It is in FileWrites, and among the files returned, whether or not
        this run touched it, as it is when the run is skipped: IncrementalClean deletes a file under obj that an earlier
        build wrote and this one does not list.  The errors come last, since they end the target.
    -->
    <Target
        Name="SqlSourceRunOnline"
        Condition="'$(DesignTimeBuild)' != 'true' and '$(SqlSourceGoesOnline)' == 'true'"
        DependsOnTargets="SqlSourceWriteManifest;SqlSourceListSidecars"
        Inputs="@(SqlSourceOnlineInput);@(Compile)"
        Outputs="$(SqlSourceOnlineStamp)"
        Returns="@(SqlSourceOnlineFile)"
    >
        <PropertyGroup>
            <SqlSourceShellSpecial>[$`&quot;\\]</SqlSourceShellSpecial>
            <SqlSourceShellEscape>&quot;'$0'&quot;</SqlSourceShellEscape>
            <SqlSourceShellSpecial Condition="'$(OS)' == 'Windows_NT'">%</SqlSourceShellSpecial>
            <SqlSourceShellEscape Condition="'$(OS)' == 'Windows_NT'">%$0</SqlSourceShellEscape>
            <SqlSourceToolManifestArgument>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceManifestFile), $(SqlSourceShellSpecial), $(SqlSourceShellEscape)))</SqlSourceToolManifestArgument>
            <SqlSourceToolEnvFileArgument>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceEnvFilePath), $(SqlSourceShellSpecial), $(SqlSourceShellEscape)))</SqlSourceToolEnvFileArgument>
            <SqlSourceToolEnvFileArgument Condition="'$(OS)' == 'Windows_NT'"
                >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceToolEnvFileArgument), '\\+$', '$0$0'))</SqlSourceToolEnvFileArgument>
            <SqlSourceToolEnvFile />
            <SqlSourceToolEnvFile Condition="'$(SqlSourceEnvFileValue)' != ''"
                > --env-file &quot;$(SqlSourceToolEnvFileArgument)&quot;</SqlSourceToolEnvFile>
            <SqlSourceToolEnvFile Condition="'$(SqlSourceEnvFileValue)' == 'none'"
                > --env-file none</SqlSourceToolEnvFile>
            <SqlSourceToolLogFile>$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.log</SqlSourceToolLogFile>
            <SqlSourceToolLog />
            <SqlSourceToolLog Condition="'$(SQLSOURCE_LOG)' != ''"
                > --log &quot;$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceToolLogFile), $(SqlSourceShellSpecial), $(SqlSourceShellEscape)))&quot;</SqlSourceToolLog>
        </PropertyGroup>
        <Exec
            Command="$(SqlSourceToolCommand) describe --manifest &quot;$(SqlSourceToolManifestArgument)&quot; --online $(SqlSourceOnlineValue)$(SqlSourceToolEnvFile)$(SqlSourceToolLog)"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            IgnoreExitCode="true"
            ConsoleToMSBuild="true"
            StandardOutputImportance="low"
        >
            <Output TaskParameter="ExitCode" PropertyName="SqlSourceToolExitCode" />
            <Output TaskParameter="ConsoleOutput" ItemName="SqlSourceToolOutput" />
        </Exec>
        <PropertyGroup>
            <SqlSourceToolOutputText>@(SqlSourceToolOutput, '%0A')</SqlSourceToolOutputText>
            <SqlSourceToolFirstLine>$([System.Text.RegularExpressions.Regex]::Match($(SqlSourceToolOutputText), '^[^\n]*'))</SqlSourceToolFirstLine>
            <SqlSourceToolStarted>false</SqlSourceToolStarted>
            <SqlSourceToolStarted
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($(SqlSourceToolOutputText), '(?m)^(sqlsource:|.*: error SQLSRC\d{3}:)'))"
                >true</SqlSourceToolStarted>
            <SqlSourceToolReportedError>false</SqlSourceToolReportedError>
            <SqlSourceToolReportedError
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($(SqlSourceToolOutputText), ': error SQLSRC\d{3}:'))"
                >true</SqlSourceToolReportedError>
            <SqlSourceToolOffline>false</SqlSourceToolOffline>
            <SqlSourceToolOffline
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($(SqlSourceToolOutputText), '(?m)^sqlsource: offline:'))"
                >true</SqlSourceToolOffline>
            <SqlSourceToolUpdateAdvice />
            <SqlSourceToolUpdateAdvice
                Condition="$(SqlSourceToolFirstLine.StartsWith('sqlsource: ')) and !$(SqlSourceToolFirstLine.StartsWith('sqlsource: offline:')) and !$(SqlSourceToolFirstLine.StartsWith('sqlsource: online:')) and !$(SqlSourceToolFirstLine.StartsWith('sqlsource: summary:'))"
                >The tool may be older than the SqlSource package, and not know the options the build gives it: update it to the package's version with 'dotnet tool update SqlSource.Tool --version &lt;version&gt;'.  </SqlSourceToolUpdateAdvice>
        </PropertyGroup>
        <ItemGroup>
            <SqlSourceSidecarAfterRun Include="@(SqlSourceSidecarOfSqlFile->Exists())" />
            <SqlSourceSidecarCreated
                Include="@(SqlSourceSidecarAfterRun->Distinct())"
                Exclude="@(SqlSourceSidecarListed)"
            />
        </ItemGroup>
        <WriteLinesToFile
            File="$(SqlSourceSidecarList)"
            Lines="@(SqlSourceSidecarAfterRun)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
        <Touch
            Files="$(SqlSourceOnlineStamp)"
            AlwaysCreate="true"
            Condition="'$(SqlSourceToolExitCode)' == '0' and '$(SqlSourceToolStarted)' == 'true' and '$(SqlSourceToolOffline)' != 'true'"
        />
        <ItemGroup>
            <FileWrites Include="$(SqlSourceOnlineStamp)" />
            <SqlSourceOnlineFile Include="$(SqlSourceOnlineStamp);$(SqlSourceSidecarList);$(SqlSourceOnlineValueFile)" />
            <SqlSourceOnlineFile
                Include="$(SqlSourceManifestFile)"
                Condition="'$(SqlSourceManifestIsDefault)' == 'true'"
            />
        </ItemGroup>
        <Warning
            Code="SQLSRC026"
            File="$(MSBuildProjectFullPath)"
            Text="The build could not start the sqlsource tool, and goes on with the committed sidecars.  Run 'dotnet tool restore', or install SqlSource.Tool as a local tool, for the build to describe the queries; or set SqlSourceOnline to false to build from the sidecars without this warning."
            HelpLink="https://github.com/mbcrawfo/SqlSource/blob/main/docs/manual/diagnostics.md#sqlsrc026"
            Condition="'$(SqlSourceToolStarted)' != 'true' and $(SqlSourceOnlineValue.Equals('auto'))"
        />
        <Error
            Code="SQLSRC025"
            File="$(MSBuildProjectFullPath)"
            Text="The build could not start the sqlsource tool, and SqlSourceOnline is true.  Install SqlSource.Tool as a local tool, run 'dotnet tool restore' if the tool manifest names it already, or set SqlSourceOnline to false to build from the committed sidecars."
            HelpLink="https://github.com/mbcrawfo/SqlSource/blob/main/docs/manual/diagnostics.md#sqlsrc025"
            Condition="'$(SqlSourceToolStarted)' != 'true' and $(SqlSourceOnlineValue.Equals('true'))"
        />
        <Error
            Code="SQLSRC027"
            File="$(MSBuildProjectFullPath)"
            Text="The sqlsource tool exited with the code $(SqlSourceToolExitCode) and reported no error, so the sidecars may not be current.  $(SqlSourceToolUpdateAdvice)It printed first: '$(SqlSourceToolFirstLine)'."
            HelpLink="https://github.com/mbcrawfo/SqlSource/blob/main/docs/manual/diagnostics.md#sqlsrc027"
            Condition="'$(SqlSourceToolStarted)' == 'true' and '$(SqlSourceToolExitCode)' != '0' and '$(SqlSourceToolReportedError)' != 'true'"
        />
    </Target>
    <!--
        Gives the sidecars that SqlSourceRunOnline created, for a framework's build that called the run in a
        configuration of its own: a target returns one list, and the run's is the files that go to FileWrites.  It is
        called in that configuration after the run, and reads the run's items, which MSBuild keeps with the
        configuration.
    -->
    <Target Name="SqlSourceCreatedSidecars" Returns="@(SqlSourceSidecarCreated)" />
    <!-- editorconfig-checker-enable -->
</Project>
