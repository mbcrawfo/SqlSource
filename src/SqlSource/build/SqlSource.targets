<Project>
    <!--
        NuGet imports this file into each project that references the package, after the project's own content.

        The compiler reads each property that SqlSource.props lists, and each metadata of an AdditionalFiles item that
        it lists, from a file that the build writes with one line for each value.  A value on a line of its own, as an
        element written over several lines has it, would arrive empty there and be taken for the default, and a list
        with one word on each line would arrive as its first word.  Each trim removes the white space around a value
        and makes one space of each run of white space inside it, a line break among it, so that both forms mean what
        they say.  No value of the package has a meaning for white space beyond separating its words.

        A trim is on one line however long it is: white space around the expression would be part of the value.  So
        the check of the line length is off for the target of the properties, as it is for the one of the metadata.

        GenerateMSBuildEditorConfigFileCore is the target of the SDK that writes the file.  The trims run before it and
        not where this file is imported: Directory.Build.targets is imported later, and a target can add an item while
        the build runs.  A build that writes the file runs them, so a design-time build does too.

        One target is out of their reach: one that hooks GenerateMSBuildEditorConfigFileCore itself and is declared
        after this file, as in Directory.Build.targets.  MSBuild runs it after the targets here, so the metadata of a
        .sql file that it adds is not trimmed and not collected, and does not reach the compiler.  A target that adds a
        .sql file hooks SqlSourceTrimMetadataOfFiles instead, which runs it first wherever it is declared.  TD-0016.
    -->
    <!-- editorconfig-checker-disable -->
    <Target Name="SqlSourceTrimProperties" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
        <PropertyGroup>
            <SqlSourceDialect>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceDialect), '\s+', ' ').Trim())</SqlSourceDialect>
            <SqlSourceGeneratorParameters>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceGeneratorParameters), '\s+', ' ').Trim())</SqlSourceGeneratorParameters>
            <SqlSourceOutput>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceOutput), '\s+', ' ').Trim())</SqlSourceOutput>
            <SqlSourceInputModelSuffix>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceInputModelSuffix), '\s+', ' ').Trim())</SqlSourceInputModelSuffix>
            <SqlSourceOutputModelSuffix>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceOutputModelSuffix), '\s+', ' ').Trim())</SqlSourceOutputModelSuffix>
            <SqlSourceModelNamespace>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceModelNamespace), '\s+', ' ').Trim())</SqlSourceModelNamespace>
            <SqlSourceInputModelType>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceInputModelType), '\s+', ' ').Trim())</SqlSourceInputModelType>
            <SqlSourceOutputModelType>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceOutputModelType), '\s+', ' ').Trim())</SqlSourceOutputModelType>
            <SqlSourceCollectionType>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceCollectionType), '\s+', ' ').Trim())</SqlSourceCollectionType>
            <SqlSourceDatabase>$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceDatabase), '\s+', ' ').Trim())</SqlSourceDatabase>
        </PropertyGroup>
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        Outputs makes this run once for each combination of values that the metadata have, with only the items of that
        combination in reach.  Each value goes through a property because MSBuild puts metadata into an expression as
        text: inside the quotes of a property function, a value that holds a quote would end the argument early.

        The files without any of the metadata are one batch, and in most projects it holds every file.  It has nothing
        to trim, so nothing is written back to it.  The condition is on the item group because the condition of a
        target cannot read metadata.  Each metadata has a condition of its own, so that one an item does not have is
        not written to it as an empty value.

        A property as written is on one line however long its name is: white space around the value would be part of
        it, and the condition of the item group would then hold for every file.  The names of the metadata make the
        list of Outputs and the condition long too, and neither can be wrapped.  So the check of the line length is
        off for the whole target.
    -->
    <!-- editorconfig-checker-disable -->
    <Target
        Name="SqlSourceTrimMetadataOfFiles"
        BeforeTargets="GenerateMSBuildEditorConfigFileCore"
        Outputs="%(AdditionalFiles.SqlSourceDialect)|%(AdditionalFiles.SqlSourceGeneratorParameters)|%(AdditionalFiles.SqlSourceOutput)|%(AdditionalFiles.SqlSourceInputModelSuffix)|%(AdditionalFiles.SqlSourceOutputModelSuffix)|%(AdditionalFiles.SqlSourceModelNamespace)|%(AdditionalFiles.SqlSourceInputModelType)|%(AdditionalFiles.SqlSourceOutputModelType)|%(AdditionalFiles.SqlSourceCollectionType)|%(AdditionalFiles.SqlSourceDatabase)"
    >
        <PropertyGroup>
            <SqlSourceDialectAsWritten>%(AdditionalFiles.SqlSourceDialect)</SqlSourceDialectAsWritten>
            <SqlSourceGeneratorParametersAsWritten>%(AdditionalFiles.SqlSourceGeneratorParameters)</SqlSourceGeneratorParametersAsWritten>
            <SqlSourceOutputAsWritten>%(AdditionalFiles.SqlSourceOutput)</SqlSourceOutputAsWritten>
            <SqlSourceInputModelSuffixAsWritten>%(AdditionalFiles.SqlSourceInputModelSuffix)</SqlSourceInputModelSuffixAsWritten>
            <SqlSourceOutputModelSuffixAsWritten>%(AdditionalFiles.SqlSourceOutputModelSuffix)</SqlSourceOutputModelSuffixAsWritten>
            <SqlSourceModelNamespaceAsWritten>%(AdditionalFiles.SqlSourceModelNamespace)</SqlSourceModelNamespaceAsWritten>
            <SqlSourceInputModelTypeAsWritten>%(AdditionalFiles.SqlSourceInputModelType)</SqlSourceInputModelTypeAsWritten>
            <SqlSourceOutputModelTypeAsWritten>%(AdditionalFiles.SqlSourceOutputModelType)</SqlSourceOutputModelTypeAsWritten>
            <SqlSourceCollectionTypeAsWritten>%(AdditionalFiles.SqlSourceCollectionType)</SqlSourceCollectionTypeAsWritten>
            <SqlSourceDatabaseAsWritten>%(AdditionalFiles.SqlSourceDatabase)</SqlSourceDatabaseAsWritten>
        </PropertyGroup>
        <ItemGroup Condition="'$(SqlSourceDialectAsWritten)$(SqlSourceGeneratorParametersAsWritten)$(SqlSourceOutputAsWritten)$(SqlSourceInputModelSuffixAsWritten)$(SqlSourceOutputModelSuffixAsWritten)$(SqlSourceModelNamespaceAsWritten)$(SqlSourceInputModelTypeAsWritten)$(SqlSourceOutputModelTypeAsWritten)$(SqlSourceCollectionTypeAsWritten)$(SqlSourceDatabaseAsWritten)' != ''">
            <AdditionalFiles>
                <SqlSourceDialect Condition="'$(SqlSourceDialectAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceDialectAsWritten), '\s+', ' ').Trim())</SqlSourceDialect>
                <SqlSourceGeneratorParameters Condition="'$(SqlSourceGeneratorParametersAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceGeneratorParametersAsWritten), '\s+', ' ').Trim())</SqlSourceGeneratorParameters>
                <SqlSourceOutput Condition="'$(SqlSourceOutputAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceOutputAsWritten), '\s+', ' ').Trim())</SqlSourceOutput>
                <SqlSourceInputModelSuffix Condition="'$(SqlSourceInputModelSuffixAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceInputModelSuffixAsWritten), '\s+', ' ').Trim())</SqlSourceInputModelSuffix>
                <SqlSourceOutputModelSuffix Condition="'$(SqlSourceOutputModelSuffixAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceOutputModelSuffixAsWritten), '\s+', ' ').Trim())</SqlSourceOutputModelSuffix>
                <SqlSourceModelNamespace Condition="'$(SqlSourceModelNamespaceAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceModelNamespaceAsWritten), '\s+', ' ').Trim())</SqlSourceModelNamespace>
                <SqlSourceInputModelType Condition="'$(SqlSourceInputModelTypeAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceInputModelTypeAsWritten), '\s+', ' ').Trim())</SqlSourceInputModelType>
                <SqlSourceOutputModelType Condition="'$(SqlSourceOutputModelTypeAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceOutputModelTypeAsWritten), '\s+', ' ').Trim())</SqlSourceOutputModelType>
                <SqlSourceCollectionType Condition="'$(SqlSourceCollectionTypeAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceCollectionTypeAsWritten), '\s+', ' ').Trim())</SqlSourceCollectionType>
                <SqlSourceDatabase Condition="'$(SqlSourceDatabaseAsWritten)' != ''"
                    >$([System.Text.RegularExpressions.Regex]::Replace($(SqlSourceDatabaseAsWritten), '\s+', ' ').Trim())</SqlSourceDatabase>
            </AdditionalFiles>
        </ItemGroup>
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        The compiler reads the metadata from the items of SqlSourceSettingsFile: see SqlSource.props.  These are the
        files that have any of the metadata, and a project has few of them.  This depends on the trim, so that it
        copies trimmed values and leaves out a file whose values were only white space.  MSBuild does not promise an
        order for two targets that hook the same one.  SqlSourceDatabase is trimmed above and not collected: the
        compiler is not shown it.  The condition is long, and cannot be wrapped.
    -->
    <!-- editorconfig-checker-disable -->
    <Target
        Name="SqlSourceCollectSettingsFiles"
        BeforeTargets="GenerateMSBuildEditorConfigFileCore"
        DependsOnTargets="SqlSourceTrimMetadataOfFiles"
    >
        <ItemGroup>
            <SqlSourceSettingsFile
                Include="@(AdditionalFiles)"
                Condition="'%(AdditionalFiles.SqlSourceDialect)%(AdditionalFiles.SqlSourceGeneratorParameters)%(AdditionalFiles.SqlSourceOutput)%(AdditionalFiles.SqlSourceInputModelSuffix)%(AdditionalFiles.SqlSourceOutputModelSuffix)%(AdditionalFiles.SqlSourceModelNamespace)%(AdditionalFiles.SqlSourceInputModelType)%(AdditionalFiles.SqlSourceOutputModelType)%(AdditionalFiles.SqlSourceCollectionType)' != ''"
            />
        </ItemGroup>
    </Target>
    <!-- editorconfig-checker-enable -->
    <!--
        Makes the build after a .sql file is deleted, renamed or moved compile again.  A file that is gone has no
        timestamp to compare, and the SDK's own record of what the compiler was given does not hold AdditionalFiles.
        CustomAdditionalCompileInputs is the item the SDK reads for more inputs of the compiler.  The file holds a hash
        of the list and is written only when the hash changes, so a build with the same files does not compile for it.
    -->
    <Target Name="SqlSourceTrackAdditionalFiles" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
        <PropertyGroup>
            <SqlSourceFilesCache>$(IntermediateOutputPath)$(MSBuildProjectFile).SqlSource.cache</SqlSourceFilesCache>
        </PropertyGroup>
        <Hash ItemsToHash="@(AdditionalFiles)">
            <Output TaskParameter="HashResult" PropertyName="SqlSourceFilesHash" />
        </Hash>
        <WriteLinesToFile
            File="$(SqlSourceFilesCache)"
            Lines="$(SqlSourceFilesHash)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
        <ItemGroup>
            <CustomAdditionalCompileInputs Include="$(SqlSourceFilesCache)" />
            <FileWrites Include="$(SqlSourceFilesCache)" />
        </ItemGroup>
    </Target>
</Project>
