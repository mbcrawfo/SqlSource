<Project>
    <!--
        Says that the project uses SqlSource.  The sqlsource tool asks a project for this property and for nothing
        else to find that out, so it is set with no condition, and here: these props reach a project whether the
        package came from NuGet or its files are imported by path.  A project that was never restored has no props
        of a package, and so no marker.
    -->
    <PropertyGroup>
        <SqlSourceImported>true</SqlSourceImported>
    </PropertyGroup>
    <!--
        Has the SDK import SqlSource.AfterSdk.targets after its own targets and after Directory.Build.targets, so that
        the search for settings files runs after every target of the project that adds a .sql file before the
        compiler: see that file.  AfterMicrosoftNETSdkTargets is the SDK's list of files to import last, and the value
        is kept.  A project that is not of the SDK does not read it, and the package's targets search earlier there.
        The value is one line, since white space around it would be part of it, so the check of the line length is off.
    -->
    <!-- editorconfig-checker-disable -->
    <PropertyGroup>
        <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)SqlSource.AfterSdk.targets</AfterMicrosoftNETSdkTargets>
    </PropertyGroup>
    <!-- editorconfig-checker-enable -->
    <!--
        Hands every .sql file of the project to the compiler, which is the only way a source generator can see one.
        A .sql file's sidecar, the .sql.json file beside it, goes to the compiler too.
        NuGet imports this file into each project that references the package, before the project's own content, so a
        project can remove files with <AdditionalFiles Remove="..." />.  A project that sets SqlSourceIncludeFiles to
        false lists its .sql files and its sidecars as AdditionalFiles itself.

        Items are evaluated after every property, so DefaultItemExcludes already holds the output and intermediate
        folders here, whatever the project sets them to.
    -->
    <ItemGroup Condition="'$(SqlSourceIncludeFiles)' != 'false'">
        <AdditionalFiles Include="**/*.sql" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
        <AdditionalFiles Include="**/*.sql.json" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>
    <!--
        A source generator sees only the MSBuild properties and the item metadata that are listed here: the properties
        and metadata the generator reads.  Each setting is a property for the project and metadata of an
        AdditionalFiles item for one file or for the files of a glob.  SqlSourceDialect names the database whose rules
        the .sql files are read by, and SqlSourceGeneratorParameters holds generator parameters, separated by spaces.
        SqlSourceOutput says what is generated for a query.  SqlSourceInputModelSuffix, SqlSourceOutputModelSuffix,
        SqlSourceModelNamespace, SqlSourceInputModelType, SqlSourceOutputModelType and SqlSourceCollectionType say
        what the models of a query are called, where they are and what shape they have, and what a method returns
        many rows in.  SqlSourceTypeOverrides maps database types to C# types, and SqlSourceColumnTypes the columns of
        tables and views, in entries separated by white space; the tool reads neither.  SqlSourceNestedClass names the
        class that holds a type's generated members; it is a property alone, never metadata, since it belongs to a type
        and not to a file, and the tool does not read it.
        SqlSourceDatabase is trimmed and is not listed: the tool reads it, and the generator does not.
        None of this is under the condition above: a project that lists its own .sql files still needs it.

        The metadata is listed for SqlSourceSettingsFile and not for AdditionalFiles.  The SDK writes a section for
        every item of the type that is listed, into the file the compiler reads, whether the item has the metadata or
        not: for AdditionalFiles that is every .sql file of the project.  A target in SqlSource.targets puts the
        AdditionalFiles items that have any of the metadata into SqlSourceSettingsFile.  The compiler finds the
        metadata of a file by its path, so the generator still reads it for the file.

        Those sections used to do a second job: the file changed when a .sql file was deleted, renamed or moved, and
        the next build compiled again.  The target SqlSourceTrackAdditionalFiles in SqlSource.targets does that now.
    -->
    <ItemGroup>
        <CompilerVisibleProperty Include="SqlSourceDialect" />
        <CompilerVisibleProperty Include="SqlSourceGeneratorParameters" />
        <CompilerVisibleProperty Include="SqlSourceOutput" />
        <CompilerVisibleProperty Include="SqlSourceInputModelSuffix" />
        <CompilerVisibleProperty Include="SqlSourceOutputModelSuffix" />
        <CompilerVisibleProperty Include="SqlSourceModelNamespace" />
        <CompilerVisibleProperty Include="SqlSourceInputModelType" />
        <CompilerVisibleProperty Include="SqlSourceOutputModelType" />
        <CompilerVisibleProperty Include="SqlSourceCollectionType" />
        <CompilerVisibleProperty Include="SqlSourceTypeOverrides" />
        <CompilerVisibleProperty Include="SqlSourceColumnTypes" />
        <CompilerVisibleProperty Include="SqlSourceNestedClass" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceDialect" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceGeneratorParameters" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceOutput" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceInputModelSuffix" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceOutputModelSuffix" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceModelNamespace" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceInputModelType" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceOutputModelType" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceCollectionType" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceTypeOverrides" />
        <CompilerVisibleItemMetadata Include="SqlSourceSettingsFile" MetadataName="SqlSourceColumnTypes" />
    </ItemGroup>
</Project>
