<Project>
    <!--
        NuGet imports this file into the outer build of a project with several target frameworks, the build that has
        TargetFrameworks and no TargetFramework and dispatches a build of each framework, and imports build/ into those
        inner builds alone.  It holds the one target of the online build that the outer build runs, and no DLL.

        The properties are those its condition reads, defined with the same text as in build/SqlSource.targets, where
        they are explained; BuildFileTests holds the two equal.  SQLSRC026 is added to MSBuildWarningsNotAsErrors here
        too, as there.

        The values and conditions are long, and a property as written is on one line, so the check of the line length
        is off for the file.
    -->
    <!-- editorconfig-checker-disable -->
    <PropertyGroup>
        <SqlSourceOnlineValue>$(SqlSourceOnline.Trim())</SqlSourceOnlineValue>
        <SqlSourceOnlineValue
            Condition="'$(SqlSourceOnlineValue)' == '' or $(SqlSourceOnlineValue.ToLowerInvariant().Equals('auto'))"
            >auto</SqlSourceOnlineValue>
        <SqlSourceOnlineValue Condition="$(SqlSourceOnlineValue.ToLowerInvariant().Equals('true'))"
            >true</SqlSourceOnlineValue>
        <SqlSourceOnlineValue Condition="$(SqlSourceOnlineValue.ToLowerInvariant().Equals('false'))"
            >false</SqlSourceOnlineValue>
        <SqlSourceInCI>false</SqlSourceInCI>
        <SqlSourceInCI
            Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'True' or '$(TEAMCITY_VERSION)' != '' or '$(JENKINS_URL)' != ''"
            >true</SqlSourceInCI>
        <SqlSourceHasConnectionVariable>true</SqlSourceHasConnectionVariable>
        <SqlSourceHasConnectionVariable
            Condition="$([System.String]::IsNullOrWhiteSpace($([System.Environment]::GetEnvironmentVariable('SQLSOURCE_CONNECTION'))))"
            >false</SqlSourceHasConnectionVariable>
        <SqlSourceEnvFileValue>$(SqlSourceEnvFile.Trim())</SqlSourceEnvFileValue>
        <SqlSourceEnvFilePath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '.env'))</SqlSourceEnvFilePath>
        <SqlSourceEnvFilePath Condition="'$(SqlSourceEnvFileValue)' != ''"
            >$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(SqlSourceEnvFileValue)))</SqlSourceEnvFilePath>
        <SqlSourceEnvFilePath Condition="'$(SqlSourceEnvFileValue)' == 'none'" />
        <SqlSourceHasEnvFile>false</SqlSourceHasEnvFile>
        <SqlSourceHasEnvFile
            Condition="'$(SqlSourceEnvFilePath)' != '' and $([System.IO.File]::Exists($(SqlSourceEnvFilePath)))"
            >true</SqlSourceHasEnvFile>
        <SqlSourceGoesOnline>false</SqlSourceGoesOnline>
        <SqlSourceGoesOnline
            Condition="'$(SqlSourceInCI)' != 'true' and ($(SqlSourceOnlineValue.Equals('true')) or ($(SqlSourceOnlineValue.Equals('auto')) and ('$(SqlSourceHasConnectionVariable)' == 'true' or '$(SqlSourceHasEnvFile)' == 'true')))"
            >true</SqlSourceGoesOnline>
        <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);SQLSRC026</MSBuildWarningsNotAsErrors>
    </PropertyGroup>
    <!--
        Runs the sqlsource tool before the outer build dispatches the inner builds, so that the run comes before any
        inner build starts and an error of it stops the build before them.  It finds the run's framework as each inner
        build's SqlSourceDescribeOnline does, the first of TargetFrameworks, in its order, whose configuration of its
        own answers SqlSourceOnlineFramework, which only a framework that imports the package has, and calls nothing
        when none answers.  Each inner build calls SqlSourceRunOnline in the same configuration, that framework's with
        SqlSourceOnlineRun=true, one of its own that runs nothing of a framework's build, so that each framework
        searches for settings files after its own hooks of CoreCompile.  The dispatch passes only TargetFramework, so
        every inner build's calls name the configurations these calls built, and MSBuild answers them at once without
        running the tool again.  The condition is SqlSourceRunOnline's, in the outer build alone.
    -->
    <Target
        Name="SqlSourceRunOnlineBeforeDispatch"
        BeforeTargets="DispatchToInnerBuilds"
        Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' != '' and '$(DesignTimeBuild)' != 'true' and '$(SqlSourceGoesOnline)' == 'true'"
    >
        <ItemGroup>
            <SqlSourceOnlineFrameworkAsked Include="$(TargetFrameworks)" />
        </ItemGroup>
        <MSBuild
            Projects="$(MSBuildProjectFullPath)"
            Targets="SqlSourceOnlineFramework"
            Properties="TargetFramework=%(SqlSourceOnlineFrameworkAsked.Identity);SqlSourceOnlineRun=true"
            SkipNonexistentTargets="true"
        >
            <Output TaskParameter="TargetOutputs" ItemName="SqlSourceOnlineFrameworkFound" />
        </MSBuild>
        <PropertyGroup>
            <SqlSourceOnlineFrameworksFound>@(SqlSourceOnlineFrameworkFound)</SqlSourceOnlineFrameworksFound>
            <SqlSourceOnlineRunFramework>$([System.Text.RegularExpressions.Regex]::Match($(SqlSourceOnlineFrameworksFound), '[^;]+'))</SqlSourceOnlineRunFramework>
        </PropertyGroup>
        <MSBuild
            Projects="$(MSBuildProjectFullPath)"
            Targets="SqlSourceRunOnline"
            Properties="TargetFramework=$(SqlSourceOnlineRunFramework);SqlSourceOnlineRun=true"
            Condition="'$(SqlSourceOnlineRunFramework)' != ''"
        />
    </Target>
    <!-- editorconfig-checker-enable -->
</Project>
