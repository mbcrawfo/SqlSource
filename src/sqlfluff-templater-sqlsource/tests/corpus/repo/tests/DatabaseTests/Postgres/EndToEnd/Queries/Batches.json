    "{\n  // The dialect of every query of the project.\n  \"dialect\": \"postgres\",\n  // The logical database that a query is described against, unless its file names another.\n  \"database\": \"app\",\n  // What a query generates: its method and its models, which need an entry in the sidecar beside its file.\n  \"output\": \"Methods\",\n  // The suffix of the model of a query's parameters.\n  \"inputModelSuffix\": \"Args\",\n  // The kind of type that a query's input model is.\n  \"inputModelType\": \"record\",\n  // The collection that a method returns the rows of a query whose shape is many in.\n  \"collectionType\": \"IReadOnlyList\",\n  \"typeOverrides\": {\n    // The C# type that timestamptz is read as, in place of the default of the type map.\n    \"timestamptz\": \"System.DateTimeOffset\",\n  },\n  \"libraryTypes\": {\n    // Off for every query of the project but those of EndToEnd/NodaTime/, whose own settings file gives the detected\n    // library back: the project references Npgsql.NodaTime, which would otherwise turn NodaTime on here.\n    \"nodaTime\": \"off\",\n    // Off for every query of the project but those of EndToEnd/NetTopologySuite/, as for NodaTime: the project gets\n    // Npgsql.NetTopologySuite through the tool and references it for those queries.\n    \"netTopologySuite\": \"off\",\n  },\n}\n",
    "{\n  // The end of every search for settings files in this repository.  A settings file above the checkout, such as the\n  // main checkout's when this is a worktree under .claude/worktrees/, would otherwise reach every project here that\n  // has no root file of its own.\n  \"root\": true,\n}\n"
  ],
  "input": "-- The queries of the collection methods, claimed by BatchQueries: the header gives each its collection method, an\n-- overload that runs it once for each item of a collection, in batches of 1,000, in a transaction of its own unless the\n-- caller gives one or one is ambient.  The inserts name notes, and a test whose method commits makes a temporary table\n-- notes on its own connection, which PostgreSQL searches before public, so that the rows land there and the seed is\n-- left as it was.  Each insert writes the id it is given, so that a test can repeat one, and reads its account from\n-- accounts, so that an item of an account that does not exist adds no row and returns none.  A copy named with Sync\n-- after its original is the original under method-type=sync, which gives it a synchronous collection method in place\n-- of the asynchronous one, and one named with Both is under method-type=both, which gives it the two.\n-- generator: collection-method\n\n-- name: InsertNote -> one\n-- summary: Adds a note with the id it is given to the account that an id names, and returns it.\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteSync -> one\n-- summary: InsertNote, by a synchronous collection method.\n-- generator: method-type=sync\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteBoth -> one\n-- summary: InsertNote, by a synchronous collection method and an asynchronous one, which is named with Async after it.\n-- generator: method-type=both\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteRowCount -> rowcount\n-- summary: Adds a note as InsertNote does, and counts it.\n-- input-model: NoteToAdd\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId;\n\n-- name: InsertNoteRowCountSync -> rowcount\n-- summary: InsertNoteRowCount, by a synchronous collection method.\n-- generator: method-type=sync\n-- input-model: NoteToAdd\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId;\n\n-- name: InsertNoteQuietly -> none\n-- summary: InsertNoteRowCount again, under none, which returns nothing.\n-- input-model: NoteToAdd\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId;\n\n-- name: InsertNoteQuietlySync -> none\n-- summary: InsertNoteQuietly, by a synchronous collection method.\n-- generator: method-type=sync\n-- input-model: NoteToAdd\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId;\n\n-- name: FindNotes\n-- summary: The notes of the account that an id names.\n-- output-model: BatchNote\nSELECT\n    id,\n    account_id,\n    body\nFROM notes\nWHERE account_id = @accountId\nORDER BY id;\n\n-- name: FindNotesSync\n-- summary: FindNotes, by a synchronous collection method.\n-- generator: method-type=sync\n-- output-model: BatchNote\nSELECT\n    id,\n    account_id,\n    body\nFROM notes\nWHERE account_id = @accountId\nORDER BY id;\n\n-- name: FindNotesStreamBoth\n-- summary: FindNotes as a stream under method-type=both, which gives a stream its asynchronous method alone, named\n-- summary: with Async after it, and a synchronous collection method and an asynchronous one, which return arrays.\n-- generator: method-type=both\n-- collection-type: IAsyncEnumerable\n-- output-model: BatchNote\nSELECT\n    id,\n    account_id,\n    body\nFROM notes\nWHERE account_id = @accountId\nORDER BY id;\n\n-- name: FindNote -> one-optional\n-- summary: The note that an id names, if there is one.\n-- output-model: BatchNote\nSELECT\n    id,\n    account_id,\n    body\nFROM notes\nWHERE id = @id;\n\n-- name: FindNoteSync -> one-optional\n-- summary: FindNote, by a synchronous collection method.\n-- generator: method-type=sync\n-- output-model: BatchNote\nSELECT\n    id,\n    account_id,\n    body\nFROM notes\nWHERE id = @id;\n\n-- name: InsertNoteSerializable -> one\n-- summary: Adds a note as InsertNote does, in a transaction of its own at the level serializable, and returns its id\n-- summary: and the isolation level of the transaction it ran in.\n-- generator: transaction=serializable\n-- input-model: NoteToAdd\n-- output-model: IsolatedNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, current_setting('transaction_isolation') AS isolation;\n\n-- name: InsertNoteSerializableSync -> one\n-- summary: InsertNoteSerializable, by a synchronous collection method.\n-- generator: transaction=serializable method-type=sync\n-- input-model: NoteToAdd\n-- output-model: IsolatedNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, current_setting('transaction_isolation') AS isolation;\n\n-- name: InsertNoteReadCommitted -> one\n-- summary: InsertNoteSerializable again, under transaction=read-committed.\n-- generator: transaction=read-committed\n-- input-model: NoteToAdd\n-- output-model: IsolatedNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, current_setting('transaction_isolation') AS isolation;\n\n-- name: InsertNoteReadCommittedSync -> one\n-- summary: InsertNoteReadCommitted, by a synchronous collection method.\n-- generator: transaction=read-committed method-type=sync\n-- input-model: NoteToAdd\n-- output-model: IsolatedNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, current_setting('transaction_isolation') AS isolation;\n\n-- name: InsertNoteRepeatableRead -> one\n-- summary: InsertNoteSerializable again, under transaction=repeatable-read.\n-- generator: transaction=repeatable-read\n-- input-model: NoteToAdd\n-- output-model: IsolatedNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, current_setting('transaction_isolation') AS isolation;\n\n-- name: InsertNoteRepeatableReadSync -> one\n-- summary: InsertNoteRepeatableRead, by a synchronous collection method.\n-- generator: transaction=repeatable-read method-type=sync\n-- input-model: NoteToAdd\n-- output-model: IsolatedNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, current_setting('transaction_isolation') AS isolation;\n\n-- name: InsertNoteNoTransaction -> one\n-- summary: InsertNote again, under transaction=off, so that each batch commits or rolls back on its own.\n-- generator: transaction=off\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteNoTransactionSync -> one\n-- summary: InsertNoteNoTransaction, by a synchronous collection method.\n-- generator: transaction=off method-type=sync\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteInRepository -> one\n-- summary: InsertNote again, at the output repository, as an instance method of BatchQueries that runs on its\n-- summary: borrowed connection and takes no transaction.\n-- output: repository\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteInRepositorySync -> one\n-- summary: InsertNoteInRepository, by a synchronous collection method of BatchQueries.\n-- output: repository\n-- generator: method-type=sync\n-- input-model: NoteToAdd\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    id,\n    'call',\n    @body,\n    now()\nFROM accounts\nWHERE id = @accountId\nRETURNING id, account_id, body;\n\n-- name: InsertNoteAfterLock -> one\n-- summary: Adds a note as InsertNote does once it holds a shared advisory lock that a key names, for a cancellation\n-- summary: while an item waits for a lock that another connection holds.\n-- As in ListThenWait of Methods.sql, the lock is taken in a LEFT JOIN LATERAL that the row's account reaches.\n-- output-model: BatchNote\nINSERT INTO notes (id, account_id, kind, body, written_at) OVERRIDING SYSTEM VALUE\nSELECT\n    @id,\n    a.id,\n    'call',\n    @body,\n    now()\nFROM accounts AS a\nLEFT JOIN\n    -- The join takes the lock; it is joined for that alone, and adds no column.\n    LATERAL (  -- noqa: ST11\n        SELECT pg_advisory_xact_lock_shared(@lockKey)\n        WHERE a.id = @accountId\n    ) AS w\n    ON true\nWHERE a.id = @accountId\nRETURNING id, account_id, body;\n",
