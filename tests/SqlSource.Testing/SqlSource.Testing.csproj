<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The helpers that the test projects share and that need nothing of the tool, the ones that tests/README.md
        lists.  A library of the tests, never a test project of its own.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <!--
            No VersionOverride: tests/SqlSource.Tests.RoslynFloor references this library, and must stay on the pinned
            Roslyn, the oldest one supported.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Shouldly" />
        <!-- For EngineImage and SqlServerStart: it brings Testcontainers and no database driver. -->
        <PackageReference Include="Testcontainers.MsSql" />
        <!-- Assert.SkipWhen and Assert.SkipUnless, for EngineImage. -->
        <PackageReference Include="xunit.v3.assert" />
        <!-- TestContext, without what makes a project a test executable. -->
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>
    <ItemGroup>
        <!--
            The drivers whose metadata the probe of Npgsql is tested against.  They are downloaded and never
            referenced: the tests read each one's metadata from the NuGet folder, which the assembly records, and
            never load it.  The versions of both items are those of Generator/NpgsqlReferences.cs and
            Generator/SqlClientReferences.cs: a mismatch builds and fails only when a test runs.
        -->
        <PackageDownload Include="Npgsql" Version="[8.0.3];[9.0.3];[10.0.3]" />
        <!--
            The same for the probe of Microsoft.Data.SqlClient: the newest 6.0, which has no SqlVector, the newest 6.1
            and the newest 7.
        -->
        <PackageDownload Include="Microsoft.Data.SqlClient" Version="[6.0.5];[6.1.7];[7.1.1]" />
        <AssemblyMetadata Include="NuGetPackageRoot" Value="$(NuGetPackageRoot)" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SqlSource.Tests" />
        <InternalsVisibleTo Include="SqlSource.Tests.RoslynFloor" />
        <InternalsVisibleTo Include="SqlSource.DatabaseTests.Postgres" />
        <InternalsVisibleTo Include="SqlSource.DatabaseTests.Postgres.Npgsql8" />
        <InternalsVisibleTo Include="SqlSource.DatabaseTests.SqlServer" />
        <InternalsVisibleTo Include="SqlSource.DatabaseTests.SqlServer.SqlClient61" />
        <InternalsVisibleTo Include="SqlSource.Tool.Testing" />
        <InternalsVisibleTo Include="SqlSource.Tool.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SqlSource/SqlSource.csproj" />
    </ItemGroup>
</Project>
