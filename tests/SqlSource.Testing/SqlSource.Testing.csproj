<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The helpers that the test projects share and that need nothing of the tool: the harness of the generator's
        driver tests, the builder of a sidecar's records, the references to the drivers of Npgsql, and RepositoryRoot,
        which finds the repository's folder.  A library of the tests, never a test project of its own.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <!--
            No VersionOverride: tests/SqlSource.Tests.RoslynFloor references this library, and must stay on the pinned
            Roslyn, the oldest one supported.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Shouldly" />
        <!-- TestContext, without what makes a project a test executable. -->
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>
    <ItemGroup>
        <!--
            The drivers whose metadata the probe of Npgsql is tested against.  They are downloaded and never
            referenced: the tests read each one's metadata from the NuGet folder, which the assembly records, and
            never load it.
        -->
        <PackageDownload Include="Npgsql" Version="[8.0.3];[9.0.3];[10.0.3]" />
        <AssemblyMetadata Include="NuGetPackageRoot" Value="$(NuGetPackageRoot)" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SqlSource.Tests" />
        <InternalsVisibleTo Include="SqlSource.Tests.RoslynFloor" />
        <InternalsVisibleTo Include="SqlSource.Tests.Postgres" />
        <InternalsVisibleTo Include="SqlSource.Tests.Postgres.Npgsql8" />
        <InternalsVisibleTo Include="SqlSource.Tests.SqlServer" />
        <InternalsVisibleTo Include="SqlSource.Tool.Testing" />
        <InternalsVisibleTo Include="SqlSource.Tool.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SqlSource/SqlSource.csproj" />
    </ItemGroup>
</Project>
