<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The end-to-end read of all_types and new_types through Dapper, and their write and read through the generated
        methods, on Microsoft.Data.SqlClient 6.1.7, the newest release of 6.1, the oldest version that is supported.  A
        project of its own, since the end-to-end project gets SqlClient 7 through the tool it references.  The generator
        comes from a project reference, which does not bring the package's MSBuild files, so the real ones are imported
        here and at the end of this file.
    -->
    <Import Project="../../src/SqlSource/build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- SQLSRC240 stays a warning: raising VersionPrefix warns until tools/describe-end-to-end.sh runs. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);SQLSRC240</WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <!--
            The queries and the sidecars of the end-to-end project, kept at their own paths for the generator.  The
            linked queries take the settings files of their own folder, so they are generated with the end-to-end
            project's settings.
        -->
        <AdditionalFiles
            Include="../SqlSource.Tests.SqlServer/EndToEnd/Queries/AllTypes.sql"
            Link="Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../SqlSource.Tests.SqlServer/EndToEnd/Queries/AllTypes.sql.json"
            Link="Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../SqlSource.Tests.SqlServer/EndToEnd/Queries/NewTypes.sql"
            Link="Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../SqlSource.Tests.SqlServer/EndToEnd/Queries/NewTypes.sql.json"
            Link="Queries/%(Filename)%(Extension)"
        />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Dapper" />
        <PackageReference Include="GitHubActionsTestLogger" />
        <!-- The newest 6.1 release, the floor's driver: the end-to-end project gets 7 from the tool. -->
        <PackageReference Include="Microsoft.Data.SqlClient" VersionOverride="6.1.7" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Testcontainers.MsSql" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="../../src/SqlSource/SqlSource.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
        <ProjectReference Include="../SqlSource.Testing/SqlSource.Testing.csproj" />
    </ItemGroup>
    <Import Project="../../src/SqlSource/build/SqlSource.targets" />
</Project>
