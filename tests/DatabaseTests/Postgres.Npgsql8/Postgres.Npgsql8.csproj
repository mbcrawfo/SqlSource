<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The end-to-end write and read of all_types on Npgsql 8.0.9, the latest 8.0 release; 8.0 is the oldest version
        that is supported: through the generated methods, and the read through Dapper; the streaming method; and the
        write and read of noda_values through the methods and Npgsql.NodaTime 8, and of spatial_values through the
        methods and Npgsql.NetTopologySuite 8, on a PostGIS container of its own.  A project of its own, since the
        end-to-end project gets Npgsql 10 through the tool it references.
        The generator comes from a project reference, which does not bring the package's MSBuild files, so the real
        ones are imported here and at the end of this file.
    -->
    <Import Project="../../../src/SqlSource/build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- SQLSRC240 stays a warning: raising VersionPrefix warns until tools/describe-end-to-end.sh runs. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);SQLSRC240</WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <!--
            The queries and the sidecars of the end-to-end project, kept at their own paths for the generator.  The
            linked queries take the settings files of their own folder, so they are generated with the end-to-end
            project's settings.
        -->
        <AdditionalFiles Include="../Postgres/EndToEnd/Queries/AllTypes.sql" Link="Queries/%(Filename)%(Extension)" />
        <AdditionalFiles
            Include="../Postgres/EndToEnd/Queries/AllTypes.sql.json"
            Link="Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles Include="../Postgres/EndToEnd/Queries/Streaming.sql" Link="Queries/%(Filename)%(Extension)" />
        <AdditionalFiles
            Include="../Postgres/EndToEnd/Queries/Streaming.sql.json"
            Link="Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../Postgres/EndToEnd/NodaTime/Queries/NodaTime.sql"
            Link="NodaTime/Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../Postgres/EndToEnd/NodaTime/Queries/NodaTime.sql.json"
            Link="NodaTime/Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../Postgres/EndToEnd/NetTopologySuite/Queries/NetTopologySuite.sql"
            Link="NetTopologySuite/Queries/%(Filename)%(Extension)"
        />
        <AdditionalFiles
            Include="../Postgres/EndToEnd/NetTopologySuite/Queries/NetTopologySuite.sql.json"
            Link="NetTopologySuite/Queries/%(Filename)%(Extension)"
        />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Dapper" />
        <PackageReference Include="GitHubActionsTestLogger" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <!-- The latest 8.0 release, the floor's driver: the end-to-end project gets 10 from the tool it references. -->
        <PackageReference Include="Npgsql" VersionOverride="8.0.9" />
        <!--
            The plugin that pairs with the driver, and NodaTime at 3.1.9, the floor that it needs: central transitive
            pinning would otherwise raise NodaTime to the end-to-end project's version.
        -->
        <PackageReference Include="NodaTime" VersionOverride="3.1.9" />
        <PackageReference Include="Npgsql.NodaTime" VersionOverride="8.0.9" />
        <!--
            The plugin of the same release for NetTopologySuite, and NetTopologySuite at 2.5.0, the floor that it needs,
            which central transitive pinning would otherwise raise to the end-to-end project's version.
        -->
        <PackageReference Include="NetTopologySuite" VersionOverride="2.5.0" />
        <PackageReference Include="Npgsql.NetTopologySuite" VersionOverride="8.0.9" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="../../../src/SqlSource/SqlSource.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
        <ProjectReference Include="../../SqlSource.Testing/SqlSource.Testing.csproj" />
        <ProjectReference Include="../TestHarness/TestHarness.csproj" />
    </ItemGroup>
    <Import Project="../../../src/SqlSource/build/SqlSource.targets" />
</Project>
