<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The generator comes from a project reference, which does not bring the package's MSBuild files.  Importing the
        real ones, here and at the end of this file, means the end-to-end tests exercise what ships.
    -->
    <Import Project="../../../src/SqlSource/build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- SQLSRC240 stays a warning: raising VersionPrefix warns until tools/describe-end-to-end.sh runs. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);SQLSRC240</WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <!-- The scratch project of the error-path tests is a project of its own, never built or described here. -->
        <Compile Remove="EndToEnd/ErrorPaths/**" />
        <AdditionalFiles Remove="EndToEnd/ErrorPaths/**" />
        <None Remove="EndToEnd/ErrorPaths/**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Dapper" />
        <PackageReference Include="GitHubActionsTestLogger" />
        <!-- The version the tool itself references: central pinning would otherwise hold it at the generator's. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.9.0" />
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Microsoft.SqlServer.Types" />
        <!--
            The library of the queries of EndToEnd/NodaTime/, whose settings file turns it on: SQL Server's default is
            off.
        -->
        <PackageReference Include="NodaTime" />
        <!--
            The library of the queries of EndToEnd/NetTopologySuite/, whose settings file turns it on, and its reader
            and writer of SQL Server's bytes, which the generated methods read and send geography and geometry through.
        -->
        <PackageReference Include="NetTopologySuite" />
        <PackageReference Include="NetTopologySuite.IO.SqlServerBytes" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <!--
            The fixture projects SqlServer and ErrorPaths, in the output where FixtureProjects of
            tests/SqlSource.Tool.Testing copies them from.  The package's MSBuild files and the repository's
            global.json come beside them from ../../Fixtures.props.
        -->
        <None
            Include="../../SqlSource.Tool.Tests/Fixtures/Projects/SqlServer/**"
            Link="Fixtures/Projects/SqlServer/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="EndToEnd/ErrorPaths/**"
            Link="Fixtures/Projects/ErrorPaths/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <Import Project="../../Fixtures.props" />
    <ItemGroup>
        <ProjectReference
            Include="../../../src/SqlSource/SqlSource.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="true"
        />
        <ProjectReference Include="../../SqlSource.Testing/SqlSource.Testing.csproj" />
        <ProjectReference Include="../TestHarness/TestHarness.csproj" />
        <ProjectReference Include="../../SqlSource.Tool.Testing/SqlSource.Tool.Testing.csproj" />
    </ItemGroup>
    <Import Project="../../../src/SqlSource/build/SqlSource.targets" />
</Project>
