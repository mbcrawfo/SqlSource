{
  // The dialect of every query of the project.
  "dialect": "postgres",
  // The logical database that a query is described against, unless its file names another.
  "database": "app",
  // What a query generates: its method and its models, which need an entry in the sidecar beside its file.
  "output": "CodeGen",
  // The suffix of the model of a query's parameters.
  "inputModelSuffix": "Args",
  // The kind of type that a query's input model is.
  "inputModelType": "record",
  // The collection that a method returns the rows of a query whose shape is many in.
  "collectionType": "IReadOnlyList",
  "typeOverrides": {
    // The C# type that timestamptz is read as, in place of the default of the type map.
    "timestamptz": "System.DateTimeOffset",
  },
  "libraryTypes": {
    // Off for every query of the project but those of EndToEnd/NodaTime/, whose own settings file gives the detected
    // library back: the project references Npgsql.NodaTime, which would otherwise turn NodaTime on here.
    "nodaTime": "off",
  },
}
