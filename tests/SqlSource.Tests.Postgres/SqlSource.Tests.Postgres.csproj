<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The generator comes from a project reference, which does not bring the package's MSBuild files.  Importing the
        real ones, here and at the end of this file, means the end-to-end tests exercise what ships.
    -->
    <Import Project="../../src/SqlSource/build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- SQLSRC240 stays a warning: raising VersionPrefix warns until tools/describe-end-to-end.sh runs. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);SQLSRC240</WarningsNotAsErrors>
        <!-- The dialect of every query of the project. -->
        <SqlSourceDialect>postgres</SqlSourceDialect>
        <!-- The logical database that a query is described against, unless its file names another. -->
        <SqlSourceDatabase>app</SqlSourceDatabase>
        <!-- What a query generates: its SQL and its models, which need an entry in the sidecar beside its file. -->
        <SqlSourceOutput>Models</SqlSourceOutput>
        <!-- The suffix of the model of a query's parameters. -->
        <SqlSourceInputModelSuffix>Args</SqlSourceInputModelSuffix>
        <!-- The kind of type that a query's input model is. -->
        <SqlSourceInputModelType>record</SqlSourceInputModelType>
        <!-- The C# type that timestamptz is read as, in place of the default of the type map. -->
        <SqlSourceTypeOverrides>timestamptz=System.DateTimeOffset</SqlSourceTypeOverrides>
    </PropertyGroup>
    <ItemGroup>
        <!-- The queries of billing: sealed class output models, the suffix Row, and timestamptz as a DateTime. -->
        <AdditionalFiles
            Update="EndToEnd/Queries/Billing/**/*.sql"
            SqlSourceOutputModelType="sealed class"
            SqlSourceOutputModelSuffix="Row"
            SqlSourceTypeOverrides="timestamptz=System.DateTime"
        />
    </ItemGroup>
    <ItemGroup>
        <!-- The scratch project of the error-path tests is a project of its own, never built or described here. -->
        <Compile Remove="EndToEnd/ErrorPaths/**" />
        <AdditionalFiles Remove="EndToEnd/ErrorPaths/**" />
        <None Remove="EndToEnd/ErrorPaths/**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Dapper" />
        <PackageReference Include="GitHubActionsTestLogger" />
        <!-- The version the tool itself references: central pinning would otherwise hold it at the generator's. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <!--
            The fixture projects Single and ErrorPaths, with the package's MSBuild files and the repository's
            global.json beside them, in the output where FixtureProjects of tests/SqlSource.Tool.Testing copies them
            from.
        -->
        <None
            Include="../SqlSource.Tool.Tests/Fixtures/Projects/Single/**"
            Link="Fixtures/Projects/Single/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="EndToEnd/ErrorPaths/**"
            Link="Fixtures/Projects/ErrorPaths/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../src/SqlSource/build/SqlSource.props"
            Link="Fixtures/build/SqlSource.props"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../src/SqlSource/build/SqlSource.targets"
            Link="Fixtures/build/SqlSource.targets"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None Include="../../global.json" Link="Fixtures/global.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="../../src/SqlSource/SqlSource.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="true"
        />
        <ProjectReference Include="../SqlSource.Testing/SqlSource.Testing.csproj" />
        <ProjectReference Include="../SqlSource.Tool.Testing/SqlSource.Tool.Testing.csproj" />
    </ItemGroup>
    <Import Project="../../src/SqlSource/build/SqlSource.targets" />
</Project>
