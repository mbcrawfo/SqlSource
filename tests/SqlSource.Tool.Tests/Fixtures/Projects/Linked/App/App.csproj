<Project Sdk="Microsoft.NET.Sdk">
    <!--
        A project that SettingsFileSearchTests builds through a symbolic link to the folder above it, with the
        generator beside the tests, whose path the test gives as LinkedGenerator.  Its dialect is in the sqlsource.json
        above it and its output in the one beside it.  With LinkedFullPaths true, it lists its C# file and its .sql
        file by their full paths, through the link.
    -->
    <Import Project="../../build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup Condition="'$(LinkedFullPaths)' == 'true'">
        <Compile Remove="Queries.cs" />
        <Compile Include="$(MSBuildProjectDirectory)/Queries.cs" />
        <AdditionalFiles Remove="Widgets.sql" />
        <AdditionalFiles Include="$(MSBuildProjectDirectory)/Widgets.sql" />
    </ItemGroup>
    <ItemGroup Condition="'$(LinkedGenerator)' != ''">
        <Analyzer Include="$(LinkedGenerator)" />
    </ItemGroup>
    <Import Project="../../build/SqlSource.targets" />
</Project>
