<Project Sdk="Microsoft.NET.Sdk">
    <!--
        References as a build resolves them, written out so that the target of the package-brought assemblies can run
        by name with no restore: two packages the project lists, the second in another case, two assemblies of a
        package it does not list, a framework reference, a project reference and an assembly of no package.
    -->
    <Import Project="../build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Direct.Package" />
        <PackageReference Include="mixed.case.package" />
    </ItemGroup>
    <ItemGroup>
        <ReferencePath
            Include="lib/Direct.dll"
            NuGetPackageId="Direct.Package"
            ReferenceSourceTarget="ResolveAssemblyReference"
        />
        <ReferencePath
            Include="lib/Mixed.dll"
            NuGetPackageId="Mixed.Case.Package"
            ReferenceSourceTarget="ResolveAssemblyReference"
        />
        <ReferencePath
            Include="lib/Brought.Client.dll"
            NuGetPackageId="Brought.Client"
            ReferenceSourceTarget="ResolveAssemblyReference"
        />
        <ReferencePath
            Include="lib/Brought.Client.Extra.dll"
            NuGetPackageId="Brought.Client"
            ReferenceSourceTarget="ResolveAssemblyReference"
        />
        <ReferencePath
            Include="ref/System.Runtime.dll"
            NuGetPackageId="Microsoft.NETCore.App.Ref"
            FrameworkReferenceName="Microsoft.NETCore.App"
            ReferenceSourceTarget="ResolveAssemblyReference"
        />
        <ReferencePath Include="../Other/Other.dll" NuGetPackageId="Other" ReferenceSourceTarget="ProjectReference" />
        <ReferencePath Include="lib/Plain.dll" ReferenceSourceTarget="ResolveAssemblyReference" />
    </ItemGroup>
    <Import Project="../build/SqlSource.targets" />
</Project>
