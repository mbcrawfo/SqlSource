<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="GitHubActionsTestLogger" />
        <!-- The version the tool itself references: central pinning would otherwise hold it at the generator's. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <!-- Release tracking for the one descriptor the tests bring themselves: FakeDescriber.Rejected (RS2008). -->
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
    <ItemGroup>
        <!--
            Fixtures/Projects holds projects that the tests run "dotnet msbuild" and "dotnet build" on.  They are no
            code of this project.  Fixtures/FixtureProjects.cs of tests/SqlSource.Tool.Testing copies one out of the
            repository before it is used, so they go to the output.  The package's MSBuild files and the
            repository's global.json come beside them from ../Fixtures.props.
        -->
        <Compile Remove="Fixtures/Projects/**" />
        <None Remove="Fixtures/Projects/**" />
        <None Include="Fixtures/Projects/**" CopyToOutputDirectory="PreserveNewest" />
        <!--
            Fixtures/Describers holds the cases of the describers, under a folder for each engine: a query, the
            capture of describing it and the sidecar expected of it.  Fixtures/FixtureCases.cs of
            tests/SqlSource.Tool.Testing finds them in the output.  The engine's schema.sql is beside its cases.
        -->
        <None Remove="Fixtures/Describers/**" />
        <None Include="Fixtures/Describers/**" CopyToOutputDirectory="PreserveNewest" />
        <!--
            Fixtures/Bundles holds the bug-report bundles that are replayed, under a folder for each engine: a bundle's
            files as they unzip.  BundleCases.cs of this project finds them in the output.
        -->
        <None Remove="Fixtures/Bundles/**" />
        <None Include="Fixtures/Bundles/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Import Project="../Fixtures.props" />
    <ItemGroup>
        <!-- Stryker finds the project it mutates among a test project's own references (tools/README.md). -->
        <ProjectReference Include="../../src/SqlSource.Tool/SqlSource.Tool.csproj" />
        <ProjectReference Include="../../src/SqlSource/SqlSource.csproj" />
        <ProjectReference Include="../SqlSource.Repository/SqlSource.Repository.csproj" />
        <ProjectReference Include="../SqlSource.Testing/SqlSource.Testing.csproj" />
        <ProjectReference Include="../DatabaseTests/TestHarness/TestHarness.csproj" />
        <ProjectReference Include="../SqlSource.Tool.Testing/SqlSource.Tool.Testing.csproj" />
        <!-- The stand-in of the tool, which the tests of the online build run as a build's command from the output. -->
        <ProjectReference Include="../SqlSource.Tool.StandIn/SqlSource.Tool.StandIn.csproj" />
    </ItemGroup>
</Project>
