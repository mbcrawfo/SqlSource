<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The generator comes from a project reference, which does not bring the package's MSBuild files.  Importing the
        real ones, here and at the end of this file, means the end-to-end tests exercise what ships.
    -->
    <Import Project="../../src/SqlSource/build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!--
            Token validation is off, so that EndToEnd/ shows the property reaching the generator through the MSBuild
            files: a query there without a list of its own does not check its arguments.  The list has one word on
            each line on purpose, and the word that the tests can see is the second.  The compiler reads one line of
            a value, so it would read this as empty, and SqlSource.targets is what puts the list on one line.  Each
            value below that is written over several lines is so for the same reason.
        -->
        <SqlSourceGeneratorParameters>
            sort-input
            no-token-validation
        </SqlSourceGeneratorParameters>
        <SqlSourceDialect>
            postgres
        </SqlSourceDialect>
    </PropertyGroup>
    <ItemGroup>
        <AdditionalFiles Update="EndToEnd/Dialects/ByMetadata.sql">
            <SqlSourceDialect>
                mysql
            </SqlSourceDialect>
        </AdditionalFiles>
        <AdditionalFiles Update="EndToEnd/Dialects/ByOption.sql">
            <SqlSourceDialect>
                mysql,
                no-backslash-escapes
            </SqlSourceDialect>
        </AdditionalFiles>
        <AdditionalFiles Update="EndToEnd/Parameters/Kept.sql">
            <SqlSourceGeneratorParameters>
                no-token-validation
                keep-comments
            </SqlSourceGeneratorParameters>
        </AdditionalFiles>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Bogus" />
        <PackageReference Include="GitHubActionsTestLogger" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <!-- Diagnostics/DiagnosticsDocumentTests.cs reads the document from the output folder. -->
        <None Include="../../docs/diagnostics.md" Link="docs/diagnostics.md" CopyToOutputDirectory="PreserveNewest" />
        <!-- Snapshot/SidecarExamples.cs reads the examples of the sidecar format design from the output folder. -->
        <None Update="Snapshot/Examples/*.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- Package/BuildFileTests.cs reads the MSBuild files from the output folder. -->
        <None
            Include="../../src/SqlSource/build/SqlSource.props"
            Link="build/SqlSource.props"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../src/SqlSource/build/SqlSource.targets"
            Link="build/SqlSource.targets"
            CopyToOutputDirectory="PreserveNewest"
        />
        <!--
            EndToEnd/EndToEndTests.cs reads the file that the build writes for the compiler of this project.  The SDK
            writes it before it compiles, and the copy to the output folder comes after.
        -->
        <None
            Include="$(IntermediateOutputPath)$(MSBuildProjectName).GeneratedMSBuildEditorConfig.editorconfig"
            Link="build/compiler.editorconfig"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="../../src/SqlSource/SqlSource.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="true"
        />
    </ItemGroup>
    <Import Project="../../src/SqlSource/build/SqlSource.targets" />
</Project>
