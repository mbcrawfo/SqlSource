<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The generator comes from a project reference, which does not bring the package's MSBuild files.  Importing the
        real ones, here and at the end of this file, means the end-to-end tests exercise what ships.
    -->
    <Import Project="../../src/SqlSource/build/SqlSource.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Bogus" />
        <PackageReference Include="GitHubActionsTestLogger" />
        <PackageReference Include="JsonSchema.Net" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
    <ItemGroup>
        <!-- Snapshot/SidecarExamples.cs reads the sample sidecars from the output folder. -->
        <None Update="Snapshot/Examples/*.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- Snapshot/SidecarSchemaTests.cs reads the schema from the output folder. -->
        <None
            Include="../../schemas/sidecar-v1.schema.json"
            Link="schemas/sidecar-v1.schema.json"
            CopyToOutputDirectory="PreserveNewest"
        />
        <!-- SettingsFiles/SettingsFileSchemaTests.cs reads the schema of a settings file from the output folder. -->
        <None
            Include="../../schemas/settings-v1.schema.json"
            Link="schemas/settings-v1.schema.json"
            CopyToOutputDirectory="PreserveNewest"
        />
        <!-- Package/BuildFileTests.cs reads the MSBuild files from the output folder. -->
        <None
            Include="../../src/SqlSource/build/SqlSource.props"
            Link="build/SqlSource.props"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../src/SqlSource/build/SqlSource.targets"
            Link="build/SqlSource.targets"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../src/SqlSource/build/SqlSource.AfterSdk.targets"
            Link="build/SqlSource.AfterSdk.targets"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="../../src/SqlSource/SqlSource.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="true"
        />
        <ProjectReference Include="../SqlSource.Testing/SqlSource.Testing.csproj" />
        <ProjectReference Include="../DatabaseTests/TestHarness/TestHarness.csproj" />
    </ItemGroup>
    <Import Project="../../src/SqlSource/build/SqlSource.targets" />
</Project>
